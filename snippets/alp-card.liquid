{%- comment -%}
  Product card — the first tap of the three-tap checkout.

  The photo and the name link to the product page, where size and Add to cart
  live. (Quick add was removed in Oct 2026: too glitchy on the cards.)

  product  – required
  image    – optional photo override (e.g. a second angle on the home row)
  caption  – optional title override
  loading  – 'eager' above the fold
  look     – 'centre' for a centred caption (phone home row)
  dots     – true to show the colour swatches under the price
  look     – 'bare': no card ground or frame — the shot sits on the page,
             name and price left under it, the second photo on hover
  sizes    – optional image sizes (default: a quarter on desktop, full width on phones)
  video    – true to play the product's own video (the first Shopify-hosted
             video in its media) in place of the photo: silent, looping,
             with a pause button. Used on the first card of a collection
             page. Nothing changes for a product without a video.
{%- endcomment -%}
{%- liquid
  assign photo = image | default: product.featured_media.preview_image
  assign name = caption | default: product.title
  assign price = product.price | money_without_trailing_zeros
  assign alt_photo = blank
  if look == 'bare' and image == blank and product.media.size > 1
    assign alt_photo = product.media[1].preview_image
  endif
  assign clip = blank
  if video
    for m in product.media
      if m.media_type == 'video'
        assign clip = m
        break
      endif
    endfor
  endif
  if clip != blank
    assign alt_photo = blank
  endif
-%}
<div class="alp-card{% if look == 'centre' %} alp-card--centre{% elsif look == 'bare' %} alp-card--bare{% endif %}" data-alp-card>
  <div class="alp-card__media">
    <a href="{{ product.url }}" class="alp-card__link" tabindex="-1" aria-hidden="true">
      {%- if photo != blank -%}
        {{ photo | image_url: width: 1200 | image_tag: class: 'alp-fill', loading: loading | default: 'lazy', widths: '400, 600, 800, 1200', sizes: sizes | default: '(min-width: 750px) 25vw, 100vw', alt: '' }}
      {%- endif -%}
      {%- if alt_photo != blank -%}
        {{ alt_photo | image_url: width: 1200 | image_tag: class: 'alp-fill alp-card__alt', loading: 'lazy', fetchpriority: 'low', widths: '400, 600, 800, 1200', sizes: sizes | default: '(min-width: 750px) 25vw, 100vw', alt: '' }}
      {%- endif -%}
      {%- if clip != blank -%}
        {{ clip | video_tag: class: 'alp-fill alp-card__video', autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '800x' }}
      {%- endif -%}
    </a>
    {%- if clip != blank -%}
      <button class="alp-card__pause" type="button" data-alp-card-pause aria-pressed="false" aria-label="Pause video">
        <svg class="alp-card__pause-on" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2" y="1" width="3" height="10"/><rect x="7" y="1" width="3" height="10"/></svg>
        <svg class="alp-card__pause-off" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1l8 5-8 5z"/></svg>
      </button>
    {%- endif -%}
  </div>
  <p class="alp-card__cap">
    <a href="{{ product.url }}" class="alp-card__name">{{ name | escape }}</a>
    <span class="alp-card__price">{% if product.available %}{{ price }}{% else %}Sold out{% endif %}</span>
    {%- if dots -%}
      {%- for o in product.options_with_values -%}
        {%- assign oname = o.name | downcase -%}
        {%- if oname contains 'colour' or oname contains 'color' -%}
          <span class="alp-card__dots" aria-label="{{ o.values.size }} colours">
            {%- for value in o.values -%}
              <span class="alp-card__dot" title="{{ value | escape }}"{% if value.swatch.color != blank %} style="--sw: {{ value.swatch.color }}"{% elsif value.swatch.image != blank %} style="--sw-img: url({{ value.swatch.image | image_url: width: 40 }})"{% endif %}></span>
            {%- endfor -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </p>
</div>
