{%- comment -%}
  Product card — the first tap of the three-tap checkout.

  The photo and the name link to the product page, where size and Add to cart
  live. (Quick add was removed in Oct 2026: too glitchy on the cards.)

  product  – required
  image    – optional photo override (e.g. a second angle on the home row)
  caption  – optional title override
  loading  – 'eager' above the fold
  look     – 'centre' for a centred caption (phone home row)
  dots     – true to show the colour swatches under the price
  sizes    – optional image sizes (default: a quarter on desktop, full width on phones)
{%- endcomment -%}
{%- liquid
  assign photo = image | default: product.featured_media.preview_image
  assign name = caption | default: product.title
  assign price = product.price | money_without_trailing_zeros
-%}
<div class="alp-card{% if look == 'centre' %} alp-card--centre{% endif %}" data-alp-card>
  <div class="alp-card__media">
    <a href="{{ product.url }}" class="alp-card__link" tabindex="-1" aria-hidden="true">
      {%- if photo != blank -%}
        {{ photo | image_url: width: 1200 | image_tag: class: 'alp-fill', loading: loading | default: 'lazy', widths: '400, 600, 800, 1200', sizes: sizes | default: '(min-width: 750px) 25vw, 100vw', alt: '' }}
      {%- endif -%}
    </a>
  </div>
  <p class="alp-card__cap">
    <a href="{{ product.url }}" class="alp-card__name">{{ name | escape }}</a>
    <span class="alp-card__price">{% if product.available %}{{ price }}{% else %}Sold out{% endif %}</span>
    {%- if dots -%}
      {%- for o in product.options_with_values -%}
        {%- assign oname = o.name | downcase -%}
        {%- if oname contains 'colour' or oname contains 'color' -%}
          <span class="alp-card__dots" aria-label="{{ o.values.size }} colours">
            {%- for value in o.values -%}
              <span class="alp-card__dot" title="{{ value | escape }}"{% if value.swatch.color != blank %} style="--sw: {{ value.swatch.color }}"{% elsif value.swatch.image != blank %} style="--sw-img: url({{ value.swatch.image | image_url: width: 40 }})"{% endif %}></span>
            {%- endfor -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </p>
</div>
