{%- comment -%}
  Product card — the first tap of the three-tap checkout.

  Desktop: hovering (or focusing) the photo raises a white "Quick add" strip
  with the sizes; clicking one adds it and opens the cart drawer.
  Phone: a "Quick add +" chip opens the size sheet (colours, then that
  colour's sizes); tapping a size adds it.

  A Colour x Size product shows the colours, then the active colour's sizes;
  any other product lists its variant titles, so the strip works for all. The card carries its own variant data for the
  sheet, read by alpine.js — no product fetch between tap one and tap two.

  product  – required
  image    – optional photo override (e.g. a second angle on the home row)
  caption  – optional title override
  quick    – false to drop Quick add (e.g. the second angle of the same item)
  loading  – 'eager' above the fold
{%- endcomment -%}
{%- liquid
  assign photo = image | default: product.featured_media.preview_image
  assign name = caption | default: product.title
  assign show_quick = true
  if quick == false or product.available == false
    assign show_quick = false
  endif
  assign price = product.price | money_without_trailing_zeros

  comment
    Two options with a colour among them: the strip shows the colours once and
    only the active colour's sizes — not every colour x size as its own button.
  endcomment
  assign q_colour = -1
  if show_quick and product.options.size == 2
    for o in product.options_with_values
      assign oname = o.name | downcase
      if oname contains 'colour' or oname contains 'color'
        assign q_colour = forloop.index0
        assign q_colours = o.values
      endif
    endfor
  endif
  assign q_size = 1 | minus: q_colour
  assign q_active = ''
  if q_colour >= 0
    for colour in q_colours
      for v in product.variants
        if q_active == '' and v.available and v.options[q_colour] == colour
          assign q_active = colour
        endif
      endfor
    endfor
    if q_active == ''
      assign q_active = q_colours.first
    endif
  endif
-%}
<div class="alp-card" data-alp-card>
  <div class="alp-card__media">
    <a href="{{ product.url }}" class="alp-card__link" tabindex="-1" aria-hidden="true">
      {%- if photo != blank -%}
        {{ photo | image_url: width: 1200 | image_tag: class: 'alp-fill', loading: loading | default: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 25vw, 100vw', alt: '' }}
      {%- endif -%}
    </a>

    {%- if show_quick -%}
      <div class="alp-card__quick alp-d{% if q_colour >= 0 %} alp-card__quick--split{% endif %}" role="group" aria-label="Quick add {{ product.title | escape }}">
        <span class="alp-card__quick-label">Quick add</span>
        {%- if q_colour >= 0 -%}
          <span class="alp-card__qbody">
            <span class="alp-card__colours" role="group" aria-label="Colour">
              {%- for colour in q_colours -%}
                <button type="button" class="alp-card__colour" data-alp-qcolour="{{ colour | escape }}" aria-pressed="{% if colour == q_active %}true{% else %}false{% endif %}">{{ colour | escape }}</button>
              {%- endfor -%}
            </span>
            {%- for colour in q_colours -%}
              <span class="alp-card__sizes" data-alp-qgroup="{{ colour | escape }}"{% unless colour == q_active %} hidden{% endunless %}>
                {%- for v in product.variants -%}
                  {%- if v.options[q_colour] != colour -%}{%- continue -%}{%- endif -%}
                  <button type="button" class="alp-card__size" data-alp-add="{{ v.id }}" data-alp-size="{{ v.title | escape }}"{% unless v.available %} disabled{% endunless %} aria-label="Add {{ product.title | escape }}, {{ v.title | escape }}{% unless v.available %}, sold out{% endunless %}">{{ v.options[q_size] | escape }}</button>
                {%- endfor -%}
              </span>
            {%- endfor -%}
          </span>
        {%- else -%}
          <span class="alp-card__sizes">
            {%- for v in product.variants -%}
              {%- assign v_label = v.title -%}
              {%- if product.has_only_default_variant -%}{%- assign v_label = 'Add +' -%}{%- endif -%}
              <button type="button" class="alp-card__size" data-alp-add="{{ v.id }}"{% unless v.available %} disabled{% endunless %} aria-label="Add {{ product.title | escape }}{% unless product.has_only_default_variant %}, {{ v.title | escape }}{% endunless %}">{{ v_label | escape }}</button>
            {%- endfor -%}
          </span>
        {%- endif -%}
      </div>
      <button type="button" class="alp-chip alp-card__qa alp-m" data-alp-quick aria-haspopup="dialog">Quick add +</button>
      <script type="application/json" data-alp-card-data>
        {
          "title": {{ product.title | json }},
          "price": {{ price | json }},
          "image": {% if photo != blank %}{{ photo | image_url: width: 240 | json }}{% else %}""{% endif %},
          "colour": {{ q_colour }},
          "active": {{ q_active | json }},
          "variants": [
            {%- for v in product.variants -%}
              {"id": {{ v.id }}, "title": {% if product.has_only_default_variant %}"Add"{% else %}{{ v.title | json }}{% endif %}, "o": {{ v.options | json }}, "available": {{ v.available | json }}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
  <p class="alp-card__cap">
    <a href="{{ product.url }}" class="alp-card__name">{{ name | escape }}</a>
    <span class="alp-card__price">{% if product.available %}{{ price }}{% else %}Sold out{% endif %}</span>
  </p>
</div>
