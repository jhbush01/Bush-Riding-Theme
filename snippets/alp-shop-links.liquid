{%- comment -%}
  The shop's categories, straight from Shopify — nothing to keep in sync.

  • Product types — every Type on a published product (Shorts, …), each
    linking to Shopify's built-in type page (url_for_type).
  • Coming soon — every collection with no products yet. Shopify has no
    Type without a product, so an empty collection is the placeholder: make
    a "T-Shirts" collection and it shows here as "soon"; its page is a
    Notify me signup (alpine-catalogue). Add a product to it and it becomes
    an ordinary collection by itself.
  • Collections — every collection with products (Launch Collection, …).

  variant:
    list – the Shop dropdown and the phone menu
    bar  – the collection page's category bar; marks where you are
{%- endcomment -%}
{%- liquid
  assign all_url = routes.all_products_collection_url
  assign here_type = ''
  assign here_handle = ''
  if collection != blank
    assign here_type = collection.current_type
    assign here_handle = collection.handle
  endif
-%}

{%- capture soon_links -%}
  {%- for c in collections -%}
    {%- if c.handle == 'all' or c.handle == 'frontpage' or c.products_count > 0 -%}{%- continue -%}{%- endif -%}
    {%- assign on = false -%}
    {%- if variant == 'bar' and here_handle == c.handle -%}{%- assign on = true -%}{%- endif -%}
    <a class="alp-cats__item is-soon{% if on %} is-on{% endif %}" href="{{ c.url }}"{% if on %} aria-current="page"{% endif %}{% if menu_link %} data-alp-close{% endif %}>{{ c.title | escape }} <small>{% if variant == 'bar' %}soon{% else %}· next drop{% endif %}</small></a>
  {%- endfor -%}
{%- endcapture -%}

{%- capture collection_links -%}
  {%- for c in collections -%}
    {%- if c.handle == 'all' or c.handle == 'frontpage' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
    {%- assign on = false -%}
    {%- if variant == 'bar' and here_handle == c.handle and here_type == blank -%}{%- assign on = true -%}{%- endif -%}
    <a class="alp-cats__item{% if on %} is-on{% endif %}" href="{{ c.url }}"{% if on %} aria-current="page"{% endif %}{% if menu_link %} data-alp-close{% endif %}>{{ c.title | escape }}</a>
  {%- endfor -%}
{%- endcapture -%}

{%- if variant == 'bar' -%}
  <a class="alp-cats__item{% if here_handle == 'all' and here_type == blank %} is-on{% endif %}" href="{{ all_url }}">View all</a>
  {%- for t in shop.types -%}
    {%- if t != blank -%}
      <a class="alp-cats__item{% if here_type == t %} is-on{% endif %}" href="{{ t | url_for_type }}"{% if here_type == t %} aria-current="page"{% endif %}>{{ t | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
  {{ soon_links }}
  {%- if collection_links != blank -%}
    <span class="alp-cats__rule" aria-hidden="true"></span>
    {{ collection_links }}
  {%- endif -%}
{%- else -%}
  <p class="alp-cats__head">Shop</p>
  <a class="alp-cats__item" href="{{ all_url }}"{% if menu_link %} data-alp-close{% endif %}>View all</a>
  {%- for t in shop.types -%}
    {%- if t != blank -%}
      <a class="alp-cats__item" href="{{ t | url_for_type }}"{% if menu_link %} data-alp-close{% endif %}>{{ t | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
  {{ soon_links }}
  {%- if collection_links != blank -%}
    <p class="alp-cats__head">Collections</p>
    {{ collection_links }}
  {%- endif -%}
{%- endif -%}
