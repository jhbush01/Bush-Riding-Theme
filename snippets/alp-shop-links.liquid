{%- comment -%}
  The shop's categories, straight from Shopify — nothing to keep in sync.

  • Product types — every Type on a published product (Shorts, …), each
    linking to Shopify's built-in type page (url_for_type).
  • Coming soon — every collection with no products yet. Shopify has no
    Type without a product, so an empty collection is the placeholder: make
    a "T-Shirts" collection and it shows here as "soon"; its page is a
    Notify me signup (alpine-catalogue). Add a product to it and it becomes
    an ordinary collection by itself.
  • Collections — every collection with products (Launch Collection, …).

  A collection whose handle matches a Type (shorts for "Shorts") stands in
  for that Type: the Type's link goes to the collection — where Shopify's
  filters work — and the collection isn't listed a second time.

  variant:
    list – the phone menu: Types, then Collections
    drop – Collections, then Types, in one list
    collections / types – one column each, for the desktop mega menu
{%- endcomment -%}
{%- liquid
  assign all_url = routes.all_products_collection_url
  assign type_handles = '|'
  for t in shop.types
    if t != blank
      assign th = t | handleize
      assign type_handles = type_handles | append: th | append: '|'
    endif
  endfor
-%}

{%- capture soon_links -%}
  {%- for c in collections -%}
    {%- if c.handle == 'all' or c.handle == 'frontpage' or c.products_count > 0 -%}{%- continue -%}{%- endif -%}
  {%- assign key = '|' | append: c.handle | append: '|' -%}
  {%- if type_handles contains key -%}{%- continue -%}{%- endif -%}
    <a class="alp-cats__item is-soon" href="{{ c.url }}"{% if menu_link %} data-alp-close{% endif %}>{{ c.title | escape }} <small>· next drop</small></a>
  {%- endfor -%}
{%- endcapture -%}

{%- capture collection_links -%}
  {%- for c in collections -%}
    {%- if c.handle == 'all' or c.handle == 'frontpage' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
    {%- assign key = '|' | append: c.handle | append: '|' -%}
    {%- if type_handles contains key -%}{%- continue -%}{%- endif -%}
    <a class="alp-cats__item" href="{{ c.url }}"{% if menu_link %} data-alp-close{% endif %}>{{ c.title | escape }}</a>
  {%- endfor -%}
{%- endcapture -%}

{%- if variant == 'collections' -%}
  {{ collection_links }}
{%- elsif variant == 'types' -%}
  {%- for t in shop.types -%}
    {%- if t != blank -%}
      {%- liquid
        assign th = t | handleize
        assign t_url = t | url_for_type
        assign twin = collections[th]
        if twin.products_count > 0
          assign t_url = twin.url
        endif
      -%}
      <a class="alp-cats__item" href="{{ t_url }}">{{ t | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
  {{ soon_links }}
{%- elsif variant == 'drop' -%}
  {%- if collection_links != blank -%}
    <p class="alp-cats__head">Collections</p>
    {{ collection_links }}
  {%- endif -%}
  <p class="alp-cats__head">Types</p>
  {%- for t in shop.types -%}
    {%- if t != blank -%}
      {%- liquid
        assign th = t | handleize
        assign t_url = t | url_for_type
        assign twin = collections[th]
        if twin.products_count > 0
          assign t_url = twin.url
        endif
      -%}
      <a class="alp-cats__item" href="{{ t_url }}">{{ t | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
  {{ soon_links }}
{%- else -%}
  <p class="alp-cats__head">Shop</p>
  <a class="alp-cats__item" href="{{ all_url }}"{% if menu_link %} data-alp-close{% endif %}>View all</a>
  {%- for t in shop.types -%}
    {%- if t != blank -%}
      {%- liquid
        assign th = t | handleize
        assign t_url = t | url_for_type
        assign twin = collections[th]
        if twin.products_count > 0
          assign t_url = twin.url
        endif
      -%}
      <a class="alp-cats__item" href="{{ t_url }}"{% if menu_link %} data-alp-close{% endif %}>{{ t | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
  {{ soon_links }}
  {%- if collection_links != blank -%}
    <p class="alp-cats__head">Collections</p>
    {{ collection_links }}
  {%- endif -%}
{%- endif -%}
