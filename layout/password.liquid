<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- comment -%}
      Safari tints the notch/status-bar with theme-color. Olive, because the
      page opens on a scrimmed video rather than the bone ground.
    {%- endcomment -%}
    <meta name="theme-color" content="#4c4b3b">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    <meta name="description" content="{{ page_description | escape }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- comment -%}
      The same two faces the storefront loads, and the storefront's own tokens.
      This page used to load Instrument Serif and General Sans and hardcode a
      palette of its own, which is how it was still showing the study's yellow
      long after the brand board retired it. Linking alpine.css means the
      palette can only ever be the one the rest of the site is using.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    {{ 'alpine.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="waitlist">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
