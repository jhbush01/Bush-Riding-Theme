{
  "version": 8,
  "name": "Bush Riding — Documentary Light (OpenFreeMap)",
  "metadata": {
    "comment": "Brand-recoloured basemap on the OpenMapTiles schema, served by OpenFreeMap (free, no key, whole planet). Muted stone/sage palette. Relief layers read a separate DEM source from 3D terrain (MapLibre warns against sharing one) and are gated to zoom 6+, so the wide view costs no DEM tiles."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> &copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a> contributors"
    },
    "terrain-dem": {
      "type": "raster-dem",
      "tiles": [
        "https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"
      ],
      "encoding": "terrarium",
      "tileSize": 512,
      "maxzoom": 14,
      "attribution": "Terrain: &copy; Geoscience Australia (CC BY 4.0); contains modified Copernicus DEM data; via <a href=\"https://mapterhorn.com/attribution\" target=\"_blank\" rel=\"noopener\">Mapterhorn</a>"
    },
    "satellite-s2": {
      "type": "raster",
      "tiles": [
        "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg"
      ],
      "tileSize": 256,
      "maxzoom": 14,
      "attribution": "<a href=\"https://s2maps.eu\" target=\"_blank\" rel=\"noopener\">Sentinel-2 cloudless</a> by <a href=\"https://eox.at\" target=\"_blank\" rel=\"noopener\">EOX IT Services GmbH</a> (contains modified Copernicus Sentinel data 2020) &mdash; CC BY 4.0"
    },
    "satellite-esri": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "Imagery &copy; Esri, Maxar, Earthstar Geographics, and the GIS User Community"
    },
    "terrain-dem-shade": {
      "type": "raster-dem",
      "tiles": [
        "https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"
      ],
      "encoding": "terrarium",
      "tileSize": 512,
      "maxzoom": 14,
      "attribution": "Terrain: &copy; Geoscience Australia (CC BY 4.0); contains modified Copernicus DEM data; via <a href=\"https://mapterhorn.com/attribution\" target=\"_blank\" rel=\"noopener\">Mapterhorn</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#E7E3D6"
      }
    },
    {
      "id": "color-relief",
      "type": "color-relief",
      "source": "terrain-dem-shade",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "color-relief-opacity": 0.75,
        "color-relief-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "elevation"
          ],
          -10,
          "#AFC0BE",
          0,
          "#C8CFB4",
          150,
          "#D5D9C0",
          300,
          "#E0E0CB",
          450,
          "#E6E2D1",
          600,
          "#E2DBC6",
          800,
          "#D9CFB7",
          1000,
          "#CDC0A6",
          1250,
          "#BFB095",
          1600,
          "#B0A084"
        ]
      },
      "minzoom": 6
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain-dem-shade",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "hillshade-method": "igor",
        "hillshade-exaggeration": 0.42,
        "hillshade-illumination-direction": 315,
        "hillshade-shadow-color": "#6B5A42",
        "hillshade-highlight-color": "#FBF6E6",
        "hillshade-accent-color": "#8A7A5C"
      },
      "minzoom": 6
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "wood",
        "forest"
      ],
      "paint": {
        "fill-color": "#AFB89C",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "grass",
        "scrub",
        "heath",
        "farmland"
      ],
      "paint": {
        "fill-color": "#DCDFC8",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#CBD2B8",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "==",
        "$type",
        "Polygon"
      ],
      "paint": {
        "fill-color": "#A7BFBD"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#A7BFBD",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          14,
          1.6
        ]
      }
    },
    {
      "id": "satellite",
      "type": "raster",
      "source": "satellite-s2",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 1,
        "raster-fade-duration": 180
      }
    },
    {
      "id": "satellite-esri",
      "type": "raster",
      "source": "satellite-esri",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 1,
        "raster-fade-duration": 180
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "track",
        "path"
      ],
      "minzoom": 12,
      "paint": {
        "line-color": "#F4EFE2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.4,
          16,
          2
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "secondary",
        "tertiary"
      ],
      "paint": {
        "line-color": "#FBF8F0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          16,
          4
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "primary",
        "trunk"
      ],
      "paint": {
        "line-color": "#F3EFE6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.6,
          16,
          5
        ]
      },
      "minzoom": 5
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "motorway"
      ],
      "paint": {
        "line-color": "#EFEADD",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.8,
          16,
          6
        ]
      },
      "minzoom": 4
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "<=",
        "admin_level",
        2
      ],
      "paint": {
        "line-color": "#B7AE97",
        "line-dasharray": [
          2,
          1.5
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.6,
          10,
          1.4
        ]
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        "class",
        "city",
        "town",
        "village"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          10,
          12,
          14
        ],
        "text-max-width": 7,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#5A5346",
        "text-halo-color": "#EDE7D7",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "==",
        "class",
        "state"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          10,
          8,
          13
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#8A8068",
        "text-halo-color": "#EDE7D7",
        "text-halo-width": 1.2
      }
    }
  ]
}
