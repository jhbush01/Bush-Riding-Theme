{
  "version": 8,
  "name": "Bush Riding — Vintage Topo (3D demo)",
  "metadata": {
    "comment": "THROWAWAY FORK of map/styles/bush.json for the vintage 3D topo demo. NOT kept in sync with production — if bush.json changes, this does not follow. Layer order matters: color-relief and hillshade are declared HERE, so route/pin layers added at runtime by topo.js (which append without beforeId) land on top of them automatically. See FINDINGS.md."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> &copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a> contributors"
    },
    "terrainSource": {
      "type": "raster-dem",
      "tiles": ["https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"],
      "encoding": "terrarium",
      "tileSize": 512,
      "maxzoom": 14,
      "attribution": "Terrain: &copy; Geoscience Australia (CC BY 4.0); contains modified Copernicus DEM data; via <a href=\"https://mapterhorn.com/attribution\" target=\"_blank\" rel=\"noopener\">Mapterhorn</a>"
    },
    "hillshadeSource": {
      "type": "raster-dem",
      "tiles": ["https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"],
      "encoding": "terrarium",
      "tileSize": 512,
      "maxzoom": 14,
      "attribution": "Terrain: &copy; Geoscience Australia (CC BY 4.0); contains modified Copernicus DEM data; via <a href=\"https://mapterhorn.com/attribution\" target=\"_blank\" rel=\"noopener\">Mapterhorn</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#E6DFCB" }
    },

    {
      "id": "color-relief",
      "type": "color-relief",
      "source": "hillshadeSource",
      "paint": {
        "color-relief-opacity": 0.9,
        "color-relief-color": [
          "interpolate",
          ["linear"],
          ["elevation"],
          -10, "#A7BFBD",
          0, "#C4CFAC",
          80, "#CFD8B8",
          180, "#DCE0C0",
          300, "#E9E2D0",
          450, "#E4D8B6",
          600, "#DCC79B",
          780, "#D0AE7C",
          950, "#C39264",
          1150, "#B47850",
          1400, "#A2603C",
          1800, "#8E4E32"
        ]
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "hillshadeSource",
      "paint": {
        "hillshade-method": "igor",
        "hillshade-exaggeration": 0.55,
        "hillshade-illumination-direction": 315,
        "hillshade-shadow-color": "#6B5A42",
        "hillshade-highlight-color": "#FBF6E6",
        "hillshade-accent-color": "#8A7A5C"
      }
    },

    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": { "fill-color": "#8E9B72", "fill-opacity": 0.22 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#7F8F63", "fill-opacity": 0.14 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#9DB8B6", "fill-outline-color": "#75908E" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8FAEAC",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 14, 1.4]
      }
    },

    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "minzoom": 12,
      "paint": {
        "line-color": "#7A6A52",
        "line-opacity": 0.5,
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 16, 1.3]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#6E5C45",
        "line-opacity": 0.55,
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 16, 2.2]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": {
        "line-color": "#8A5A34",
        "line-opacity": 0.62,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 16, 3]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#9E5F30",
        "line-opacity": 0.7,
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.7, 16, 4]
      }
    },

    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": {
        "line-color": "#6B5A42",
        "line-opacity": 0.5,
        "line-dasharray": [2, 1.5],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 10, 1.4]
      }
    },

    {
      "id": "mountain-peak",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "case",
          ["has", "ele"],
          ["concat", ["coalesce", ["get", "name:en"], ["get", "name"]], "\n", ["to-string", ["round", ["get", "ele"]]], " m"],
          ["coalesce", ["get", "name:en"], ["get", "name"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 9, 14, 11.5],
        "text-line-height": 1.1,
        "text-anchor": "bottom",
        "text-letter-spacing": 0.04
      },
      "paint": {
        "text-color": "#4A3B27",
        "text-halo-color": "#EDE7D7",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 12, 13.5],
        "text-max-width": 7,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12
      },
      "paint": {
        "text-color": "#4A3B27",
        "text-halo-color": "#EDE7D7",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 8, 13],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.18,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#7A6A52",
        "text-halo-color": "#EDE7D7",
        "text-halo-width": 1.2
      }
    }
  ],
  "sky": {
    "sky-color": "#C6CFC0",
    "horizon-color": "#E2D9BE",
    "fog-color": "#E6DFCB",
    "fog-ground-blend": 0.62,
    "horizon-fog-blend": 0.5,
    "sky-horizon-blend": 0.7
  }
}
