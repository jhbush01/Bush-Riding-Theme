{%- comment -%}
  About (D10 / M11). A 720px split — documentary photo | the story with two
  facts at its foot — then "Made for the detour." as a statement, then three
  photos (two on a phone).
  The story is the page's own content when it has any, so it's edited in
  Online Store → Pages like any other page; the text here is the fallback.
{%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.only_handle != blank and template.name == 'page' and page.handle != section.settings.only_handle
    assign show = false
  endif
-%}
{%- if show -%}
<section class="alp alp-about">
  <div class="alp-about__split">
    <div class="alp-about__photo">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'alp-fill', loading: 'eager', widths: '600, 1000, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt | default: '' }}
      {%- endif -%}
    </div>
    <div class="alp-about__text">
      <h1 class="alp-about__title">{{ section.settings.heading | default: page.title | escape }}</h1>
      <div class="alp-about__body">
        {%- if page.content != blank -%}{{ page.content }}{%- else -%}{{ section.settings.body }}{%- endif -%}
      </div>
      <span class="alp-about__fill"></span>
      <dl class="alp-about__facts">
        <div><dt>{{ section.settings.fact_1_label | escape }}</dt><dd>{{ section.settings.fact_1 | escape }}</dd></div>
        <div>
          <dt>{{ section.settings.fact_2_label | escape }}</dt>
          <dd>{% if settings.alp_strava_url != blank %}<a href="{{ settings.alp_strava_url }}" target="_blank" rel="noopener">{{ section.settings.fact_2 | escape }}</a>{% else %}{{ section.settings.fact_2 | escape }}{% endif %}</dd>
        </div>
      </dl>
    </div>
  </div>

  {%- if section.settings.statement != blank -%}
    <p class="alp-about__statement">{{ section.settings.statement | escape }}</p>
  {%- endif -%}

  <div class="alp-about__trio">
    {%- for i in (1..3) -%}
      {%- assign key = 'photo_' | append: i -%}
      <div class="alp-about__tri{% if i == 3 %} alp-d{% endif %}">
        {%- if section.settings[key] != blank -%}
          {{ section.settings[key] | image_url: width: 1000 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{%- endif -%}

{% schema %}
{
  "name": "About",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "only_handle", "label": "Only on the page with handle", "info": "Used on the default page template, where every page shares one layout list. Leave empty to always show." },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About Bush Riding" },
    {
      "type": "richtext", "id": "body", "label": "Story",
      "default": "<p>We make technical gravel kit for riders who care more about the detour than the podium. The journey matters more than the pace, and the café stop is part of the ride.</p><p>Everything is designed in Australia, gender-neutral, and priced so more of us can ride in it.</p>",
      "info": "Used only when the page itself has no content."
    },
    { "type": "text", "id": "fact_1_label", "label": "Fact 1", "default": "Designed in" },
    { "type": "text", "id": "fact_1", "label": "Fact 1 value", "default": "Australia" },
    { "type": "text", "id": "fact_2_label", "label": "Fact 2", "default": "Ride with us" },
    { "type": "text", "id": "fact_2", "label": "Fact 2 value (links to Strava)", "default": "Strava group" },
    { "type": "text", "id": "statement", "label": "Statement", "default": "Made for the detour." },
    { "type": "image_picker", "id": "photo_1", "label": "Photo 1" },
    { "type": "image_picker", "id": "photo_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "photo_3", "label": "Photo 3 (desktop only)" }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}
