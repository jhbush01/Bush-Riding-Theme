{%- comment -%}
  About (D10 / M11) — Nov 2026 rebuild: the brand story told in full colour,
  from its roots (the drovers' stock routes) to the kit, one coloured band
  per chapter. Phones and desktop; phones stack each band.

    1. Opening photo, full bleed, the header clear over it — eyebrow + title
    2. Olive  — 01 The old tracks: the drovers, the stock routes
    3. Mist   — 02 A different steed: steel frame and bar bag; photo beside
    4. Two photos, edge to edge
    5. Olive  — 03 What's out there: six kinds of country, one line each
    6. Bone   — 04 What we make: the kit, four facts
    7. Flare  — Come for a ride: Rides, Bush Map, Shop

  Every word is a setting (Online Store → Customize → About), so the copy
  can change without code. The page's own content in Online Store → Pages
  isn't shown. Bands keep their colours whichever page colour (bone or
  white) Theme settings has.
{%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.only_handle != blank and template.name == 'page' and page.handle != section.settings.only_handle
    assign show = false
  endif
  capture rides_url
    render 'alp-link', to: 'rides'
  endcapture
  capture map_url
    render 'alp-link', to: 'map'
  endcapture
  assign s = section.settings
-%}
{%- if show -%}
<div class="alp alp-about">

  {%- comment -%} 1 · Opening photo {%- endcomment -%}
  <header class="alp-about__hero">
    {%- if s.image != blank -%}
      {%- assign hero_alt = s.image.alt | default: '' -%}
      {{ s.image | image_url: width: 2400 | image_tag: class: 'alp-fill', loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', alt: hero_alt }}
    {%- endif -%}
    <div class="alp-about__herotext">
      {%- if s.eyebrow != blank -%}<p class="alp-about__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="alp-about__title">{{ s.heading | default: page.title | escape }}</h1>
      {%- if s.subhead != blank -%}<p class="alp-about__sub">{{ s.subhead | escape }}</p>{%- endif -%}
    </div>
  </header>

  {%- comment -%} 2 · The old tracks {%- endcomment -%}
  <section class="alp-about__band alp-about__band--olive">
    <div class="alp-about__chapter">
      <p class="alp-about__num">{{ s.past_label | escape }}</p>
      <h2 class="alp-about__head">{{ s.past_title | escape }}</h2>
      <div class="alp-about__copy">{{ s.past_body }}</div>
    </div>
  </section>

  {%- comment -%} 3 · A different steed, the first photo beside it {%- endcomment -%}
  <section class="alp-about__band alp-about__band--mist alp-about__band--split">
    <div class="alp-about__chapter">
      <p class="alp-about__num">{{ s.now_label | escape }}</p>
      <h2 class="alp-about__head">{{ s.now_title | escape }}</h2>
      <div class="alp-about__copy">{{ s.now_body }}</div>
    </div>
    <div class="alp-about__side">
      {%- if s.photo_1 != blank -%}
        {{ s.photo_1 | image_url: width: 1400 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} 4 · Two photos, edge to edge {%- endcomment -%}
  {%- if s.photo_2 != blank or s.photo_3 != blank -%}
    <div class="alp-about__pair">
      {%- assign pair_keys = 'photo_2,photo_3' | split: ',' -%}
      {%- for key in pair_keys -%}
        {%- if s[key] != blank -%}
          <div class="alp-about__pic">
            {{ s[key] | image_url: width: 1400 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} 5 · What's out there: six kinds of country {%- endcomment -%}
  <section class="alp-about__band alp-about__band--olive">
    <div class="alp-about__chapter alp-about__chapter--wide">
      <p class="alp-about__num">{{ s.land_label | escape }}</p>
      <h2 class="alp-about__head">{{ s.land_title | escape }}</h2>
      <ol class="alp-about__land" role="list">
        {%- comment -%} Each place: its name on the first line, its line under it. {%- endcomment -%}
        {%- for i in (1..6) -%}
          {%- assign lk = 'land_' | append: i -%}
          {%- assign parts = s[lk] | strip | newline_to_br | split: '<br />' -%}
          {%- if parts.size > 0 -%}
            {%- assign place_name = parts.first | strip -%}
            {%- capture place_line -%}{%- for x in parts offset: 1 -%}{{ x | strip }} {% endfor -%}{%- endcapture -%}
            <li class="alp-about__place">
              <span class="alp-about__placenum" aria-hidden="true">0{{ i }}</span>
              <span class="alp-about__placename">{{ place_name | escape }}</span>
              {%- if place_line != blank -%}<span class="alp-about__placeline">{{ place_line | strip | escape }}</span>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} 6 · What we make {%- endcomment -%}
  <section class="alp-about__band alp-about__band--bone">
    <div class="alp-about__chapter alp-about__chapter--wide alp-about__make">
      <div>
        <p class="alp-about__num">{{ s.make_label | escape }}</p>
        <h2 class="alp-about__head">{{ s.make_title | escape }}</h2>
        <div class="alp-about__copy">{{ s.make_body }}</div>
      </div>
      <dl class="alp-about__facts">
        {%- for i in (1..4) -%}
          {%- assign lk = 'fact_' | append: i | append: '_label' -%}
          {%- assign vk = 'fact_' | append: i -%}
          {%- if s[vk] != blank -%}
            <div>
              <dt>{{ s[lk] | escape }}</dt>
              <dd>
                {%- if i == 4 and settings.alp_strava_url != blank -%}
                  <a href="{{ settings.alp_strava_url }}" target="_blank" rel="noopener">{{ s[vk] | escape }} <span aria-hidden="true">↗</span></a>
                {%- else -%}
                  {{ s[vk] | escape }}
                {%- endif -%}
              </dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>
  </section>

  {%- comment -%} 7 · Come for a ride {%- endcomment -%}
  <section class="alp-about__band alp-about__band--flare">
    <div class="alp-about__close">
      <h2 class="alp-about__head">{{ s.close_title | escape }}</h2>
      {%- if s.close_body != blank -%}<p class="alp-about__closeline">{{ s.close_body | escape }}</p>{%- endif -%}
      <div class="alp-about__go">
        <a class="alp-btn" href="{{ rides_url | strip }}">{{ s.btn_rides | escape }}</a>
        <a class="alp-btn alp-btn--line" href="{{ map_url | strip }}">{{ s.btn_map | escape }}</a>
        <a class="alp-btn alp-btn--line" href="{{ routes.all_products_collection_url }}">{{ s.btn_shop | escape }}</a>
      </div>
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "About",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "only_handle", "label": "Only on the page with handle", "info": "Used on the default page template, where every page shares one layout list. Leave empty to always show." },
    { "type": "header", "content": "Opening photo" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Full width, the header sits over it. A wide landscape works best." },
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "About Bush Riding" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Same dirt. A different steed." },
    { "type": "text", "id": "subhead", "label": "Line under the title", "default": "We make kit for riding a bike through the Australian bush, and for the long way home." },
    { "type": "header", "content": "01 · The old tracks (olive)" },
    { "type": "text", "id": "past_label", "label": "Label", "default": "01 — The old tracks" },
    { "type": "textarea", "id": "past_title", "label": "Headline", "default": "For the better part of two centuries, drovers crossed this country in the saddle." },
    { "type": "richtext", "id": "past_body", "label": "Story", "default": "<p>They trusted their horses to read the ground. Through scrub and stony creek beds, over ranges, across country that gave nothing away for free. Weeks on the move, swag rolled behind the saddle, camp wherever the water was.</p><p>They left tracks behind them. Some of those old stock routes are the gravel we ride today.</p>" },
    { "type": "header", "content": "02 · A different steed (mist)" },
    { "type": "text", "id": "now_label", "label": "Label", "default": "02 — A different steed" },
    { "type": "textarea", "id": "now_title", "label": "Headline", "default": "We swapped the horse for a steel frame, and the swag for a bar bag." },
    { "type": "richtext", "id": "now_body", "label": "Story", "default": "<p>Same dirt. Same horizons. Same hunt for shade at midday, and for a decent coffee at the end of it.</p><p>Somewhere past the city limits the noise falls away. The road narrows, the surface softens, and the country opens up. That's where we're headed. Not for a time or a podium, just for whatever's around the next bend.</p>" },
    { "type": "image_picker", "id": "photo_1", "label": "Photo beside it" },
    { "type": "header", "content": "Two photos" },
    { "type": "image_picker", "id": "photo_2", "label": "Photo left" },
    { "type": "image_picker", "id": "photo_3", "label": "Photo right" },
    { "type": "header", "content": "03 · What's out there (olive)" },
    { "type": "text", "id": "land_label", "label": "Label", "default": "03 — What's out there" },
    { "type": "textarea", "id": "land_title", "label": "Headline", "default": "Our country is vast, breathtaking, and at times unforgiving." },
    { "type": "textarea", "id": "land_1", "label": "Place 1", "default": "Storm season\nSummer storms split the sky open and clap our ears with thunder.", "info": "The place on the first line, its line under it." },
    { "type": "textarea", "id": "land_2", "label": "Place 2", "default": "River red gums\nOld river red gums groan and creak, keeping secrets older than the tracks beneath them." },
    { "type": "textarea", "id": "land_3", "label": "Place 3", "default": "High country\nIcy mornings bite our fingers and fog our breath until the sun clears the range." },
    { "type": "textarea", "id": "land_4", "label": "Place 4", "default": "The coast\nSea cliffs roar with salt spray, and the swell drowns out every other thought." },
    { "type": "textarea", "id": "land_5", "label": "Place 5", "default": "Rainforest\nThe canopy drips and hums, and the air hangs thick enough to taste." },
    { "type": "textarea", "id": "land_6", "label": "Place 6", "default": "Outback night\nStar-choked skies swallow the dark whole, and we've never felt so small." },
    { "type": "header", "content": "04 · What we make (bone)" },
    { "type": "text", "id": "make_label", "label": "Label", "default": "04 — What we make" },
    { "type": "textarea", "id": "make_title", "label": "Headline", "default": "Kit for the long way round." },
    { "type": "richtext", "id": "make_body", "label": "Text", "default": "<p>Built for a full day out in heat, dust and the odd downpour, so we can ride longer and think about the ride, not what we're wearing. Then good enough to wear into the café when we get there.</p><p>Every piece is gender-neutral, and priced so more of us can ride in it.</p>" },
    { "type": "text", "id": "fact_1_label", "label": "Fact 1", "default": "Designed in" },
    { "type": "text", "id": "fact_1", "label": "Fact 1 value", "default": "Queensland" },
    { "type": "text", "id": "fact_2_label", "label": "Fact 2", "default": "Made in" },
    { "type": "text", "id": "fact_2", "label": "Fact 2 value", "default": "Victoria" },
    { "type": "text", "id": "fact_3_label", "label": "Fact 3", "default": "Cut for" },
    { "type": "text", "id": "fact_3", "label": "Fact 3 value", "default": "Everybody" },
    { "type": "text", "id": "fact_4_label", "label": "Fact 4", "default": "Ride with us" },
    { "type": "text", "id": "fact_4", "label": "Fact 4 value (links to Strava)", "default": "Strava club" },
    { "type": "header", "content": "Come for a ride (flare)" },
    { "type": "text", "id": "close_title", "label": "Headline", "default": "Come for a ride." },
    { "type": "text", "id": "close_body", "label": "Line", "default": "Monthly group rides, routes worth the drive, and a café stop on every one." },
    { "type": "text", "id": "btn_rides", "label": "Button: Rides", "default": "Upcoming rides" },
    { "type": "text", "id": "btn_map", "label": "Button: Bush Map", "default": "Find a route" },
    { "type": "text", "id": "btn_shop", "label": "Button: Shop", "default": "Shop the kit" }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}
