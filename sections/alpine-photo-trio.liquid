{%- comment -%}
  Bush Riding photo trio (option 2a). Three photographs in a measured row —
  a wide landscape lead, then a rider, then a detail. Sits on the mist ground
  under the gate; the photography is what warms the cold field up.

  Images render via image_url | image_tag so the focal point set in the theme
  editor controls each crop.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section class="alp alp-trio">
    <div class="alp-trio__grid">
      {%- for block in section.blocks -%}
        <figure class="alp-trio__cell alp-reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.caption | default: '' }}
          {%- else -%}
            <img src="{{ 'alpine-ph-panel-portrait.svg' | asset_url }}" alt="" width="900" height="1100" loading="lazy" data-asset-note="Warm, dusty Australian landscape — riders small in frame">
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption>{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Bush Riding photo trio",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Three photographs in a row. The first is widest; on a phone they stack." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Set the crop via the image's focal point." },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Also used as the image's alt text." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Bush Riding photo trio",
      "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }]
    }
  ]
}
{% endschema %}
