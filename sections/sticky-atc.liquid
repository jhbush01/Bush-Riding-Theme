{%- comment -%}
  The pinned buy bar — phones only, per turn 9d.

  It used to appear only once you had scrolled past the native add-to-cart
  button. It is now permanent, because 9d makes it the ONLY add to cart on a
  phone: the in-page form steps aside (alpine.css, gated on the class
  alpine.js sets once it can reach that form) so the page is photography and
  copy, and the one thing to press is always under your thumb.

  That gating is the safety property and it runs both ways — if alpine.js
  cannot reach Dawn's form, it never sets the class, the in-page button stays
  exactly where it was, and this bar is simply a second way to do the same
  thing. A product must never become unbuyable because a bar failed to load.

  Adding to cart submits Dawn's own form, so the cart drawer and notification
  behave exactly as a native add. Price and availability re-sync from the page
  whenever the variant changes.

  The Menu chip rides alongside because the floating nav chips hide underneath
  it — two bars stacked at the foot of a phone is one too many.
{%- endcomment -%}

{%- if product != blank -%}
  <div id="StickyATC-{{ section.id }}" class="alp alp-buybar" data-sticky-atc hidden>
    <button class="alp-chip alp-chip--flare alp-buybar__go" type="button" data-sticky-atc-submit>
      <span data-sticky-atc-label>{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}</span>
      <span class="alp-buybar__price" data-sticky-atc-price>
        {{- product.selected_or_first_available_variant.price | money -}}
      </span>
    </button>
    {%- if section.settings.show_menu -%}
      <button class="alp-chip alp-buybar__menu" type="button" data-alp-menu-open aria-expanded="false" aria-controls="alp-menu-overlay">
        Menu <span class="alp-glyph">✦</span>
      </button>
    {%- endif -%}
  </div>

  <script>
    (function () {
      var bar = document.getElementById('StickyATC-{{ section.id }}');
      if (!bar) return;

      var mobile = window.matchMedia('(max-width: 989px)');
      var nativeSubmit = document.querySelector('.product-form__submit');
      var mainForm = document.querySelector('product-form form[data-type="add-to-cart-form"], form[action*="/cart/add"]');
      var go = bar.querySelector('[data-sticky-atc-submit]');
      var labelEl = bar.querySelector('[data-sticky-atc-label]');
      var priceEl = bar.querySelector('[data-sticky-atc-price]');

      /* No form to drive means no bar. The page keeps its own button. */
      if (!nativeSubmit || !mainForm) return;

      function render() {
        bar.hidden = !mobile.matches;
        document.body.classList.toggle('alp-buybar-up', mobile.matches);
      }
      render();
      mobile.addEventListener ? mobile.addEventListener('change', render) : mobile.addListener(render);

      function sync() {
        var priceSource = document.querySelector(
          '.product__info-container .price__container .price-item--sale, ' +
          '.product__info-container .price__container .price-item--regular, ' +
          '.price .price-item--regular'
        );
        if (priceSource && priceEl) priceEl.textContent = priceSource.textContent.trim();

        var soldOut = nativeSubmit.disabled || nativeSubmit.getAttribute('aria-disabled') === 'true';
        go.disabled = soldOut;
        if (priceEl) priceEl.hidden = soldOut;
        /* Take the wording from the native button so this follows the store's
           own locale rather than a string frozen in here. */
        var nativeLabel = nativeSubmit.querySelector('span');
        if (labelEl && nativeLabel) labelEl.textContent = nativeLabel.textContent.trim();
      }
      sync();

      document.addEventListener('change', function (e) {
        if (e.target.closest('variant-selects, variant-radios, .product-form__input, [name="id"]')) {
          /* Dawn swaps price and button state asynchronously after the change. */
          setTimeout(sync, 400);
        }
      });

      go.addEventListener('click', function () {
        if (mainForm.requestSubmit) mainForm.requestSubmit();
        else mainForm.submit();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Pinned buy bar",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Phones only. Permanently pinned — it is the only add-to-cart on a phone, so the page above it stays photography and copy."
    },
    {
      "type": "checkbox",
      "id": "show_menu",
      "label": "Show the Menu chip beside it",
      "default": true,
      "info": "The floating nav chips hide while this bar is up, so the menu needs a way back."
    }
  ],
  "presets": [
    { "name": "Pinned buy bar" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
