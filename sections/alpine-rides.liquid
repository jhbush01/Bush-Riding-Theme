{%- comment -%}
  Rides (D09 / M10) — upcoming at the top, recaps below.

  Upcoming rides come live from the routes worker's /events feed (the same
  one the map's Bush Event pins use), so a ride appears here the moment it's
  published in the map admin and drops off the day after. Cards are built by
  alpine.js from the template below. The first is the next ride, so its date
  badge is the screen's one flare. A ride's own hero image wins; otherwise
  the photos set here are used in turn.

  Recaps are the journal's articles.
{%- endcomment -%}
{%- liquid
  assign rblog = section.settings.blog
  if rblog == blank or rblog.handle == blank
    assign rblog = blogs['journal']
  endif
  if rblog == blank or rblog.handle == blank
    for b in blogs
      assign rblog = b
      break
    endfor
  endif
  capture map_url
    render 'alp-link', to: 'map'
  endcapture
-%}
<section class="alp alp-rides" data-alp-rides data-alp-limit="{{ section.settings.limit }}">
  <header class="alp-pagehead">
    <h1 class="alp-pagehead__title">{{ section.settings.heading | escape }}</h1>
    <p class="alp-pagehead__sub"><span class="alp-d">{{ section.settings.subheading | escape }}</span><span class="alp-m">{{ section.settings.subheading_mobile | escape }}</span></p>
  </header>

  <div class="alp-rides__cards" data-alp-ride-list>
    {%- comment -%} Filled by alpine.js. {%- endcomment -%}
  </div>
  <p class="alp-rides__none" data-alp-ride-none hidden>
    {{ section.settings.empty | escape }}
    {%- if settings.alp_strava_url != blank %} <a href="{{ settings.alp_strava_url }}" target="_blank" rel="noopener">Strava club</a>{% endif -%}
  </p>

  <template data-alp-ride-template>
    <article class="alp-ride">
      <a class="alp-ride__photo" data-r-link>
        <img class="alp-fill" alt="" width="900" height="600" loading="lazy" data-r-img hidden>
        <span class="alp-ride__date" data-r-date></span>
      </a>
      <div class="alp-ride__body">
        <h2 class="alp-ride__title" data-r-title></h2>
        <p class="alp-ride__meta" data-r-meta></p>
        <a class="alp-chip alp-chip--line" data-r-rsvp target="_blank" rel="noopener">RSVP</a>
      </div>
    </article>
  </template>
  <script type="application/json" data-alp-ride-photos>
    [
      {%- for i in (1..3) -%}
        {%- assign key = 'photo_' | append: i -%}
        {%- assign ph = section.settings[key] -%}
        {% if ph != blank %}{{ ph | image_url: width: 900 | json }}{% else %}""{% endif %}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
  <span hidden data-alp-ride-fallback="{{ map_url | append: '/events/' | escape }}"></span>

  {%- if rblog != blank and rblog.articles_count > 0 -%}
    <h2 class="alp-pagehead__title alp-rides__recaps">Recaps</h2>
    {%- render 'alp-recaps', articles: rblog.articles, limit: section.settings.recaps -%}
    {%- if rblog.articles_count > section.settings.recaps -%}
      <p class="alp-more"><a href="{{ rblog.url }}">All recaps</a></p>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Rides",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upcoming rides" },
    { "type": "text", "id": "subheading", "label": "Line (desktop)", "default": "Ride with us. Share your stories. Let's explore together." },
    { "type": "text", "id": "subheading_mobile", "label": "Line (phones)", "default": "Ride with us. Share your stories." },
    { "type": "range", "id": "limit", "label": "Upcoming rides shown", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "empty", "label": "When nothing is on the calendar", "default": "Nothing on the calendar just yet. The next one goes up on our" },
    { "type": "image_picker", "id": "photo_1", "label": "Ride photo 1", "info": "Used when a ride has no photo of its own." },
    { "type": "image_picker", "id": "photo_2", "label": "Ride photo 2" },
    { "type": "image_picker", "id": "photo_3", "label": "Ride photo 3" },
    { "type": "header", "content": "Recaps" },
    { "type": "blog", "id": "blog", "label": "Recaps from", "info": "Leave empty to use the store's first blog." },
    { "type": "range", "id": "recaps", "label": "Recaps shown", "min": 1, "max": 8, "step": 1, "default": 2 }
  ],
  "presets": [{ "name": "Rides" }]
}
{% endschema %}
