{%- comment -%}
  Bush Riding hero — full-bleed photograph/video filling the viewport under
  the floating nav. Two chip buttons sit centred just below the nav: one
  linking to the featured product (Bush Riding Shorts), one to the map
  (BUSH MAP™ → map.bushriding.cc).
{%- endcomment -%}

<section class="alp alp-hero">
  <div class="alp-hero__media">
    {%- comment -%}
      Clip first, image second. It used to be the other way round, which meant
      setting a poster image silently disabled the video — the opposite of what
      anyone filling in both fields expects. The image is now the poster.

      The src is deferred (data-alp-video, see alpine.js) rather than autoplay:
      the hero is above the fold so it starts immediately anyway, but going
      through the same path as every other clip means one place decides when
      video loads. No `type` on a source element either — a .mov declared as
      video/mp4 is rejected outright by the browser, which is exactly how the
      home page's clip went missing once already.
    {%- endcomment -%}
    {%- if section.settings.video_url != blank -%}
      {%- assign hero_poster = section.settings.poster | default: section.settings.image -%}
      <video
        data-alp-video="{{ section.settings.video_url }}"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        {% if hero_poster != blank %}poster="{{ hero_poster | image_url: width: 1800 }}"{% endif %}
      ></video>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: '' }}
    {%- else -%}
      <img src="{{ 'alpine-ph-hero.svg' | asset_url }}" alt="" width="800" height="1000" loading="eager"
        data-asset-note="Full-bleed hero: hiker on mossy terrain against a pale blown-out sky, as in frame f_01">
    {%- endif -%}
  </div>

  {%- if section.settings.show_wordmark -%}
    {%- comment -%}
      Decorative — the header link already carries "Bush Riding" as the
      accessible name for the home route, so this stays aria-hidden with an
      empty alt to avoid announcing the wordmark twice.
    {%- endcomment -%}
    <div class="alp-hero__wordmark" aria-hidden="true">
      {%- if section.settings.wordmark_image != blank -%}
        {{ section.settings.wordmark_image | image_url: width: 500 | image_tag: loading: 'eager', alt: '' }}
      {%- else -%}
        <img src="{{ 'wordmark-' | append: section.settings.wordmark_tone | append: '.svg' | asset_url }}" alt="" loading="eager" width="1273" height="543">
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="alp-hero__cta">
    {%- if section.settings.shorts_product != blank -%}
      <a class="alp-chip" href="{{ section.settings.shorts_product.url }}">{{ section.settings.shorts_label | default: section.settings.shorts_product.title | escape }} <span class="alp-glyph">✦</span></a>
    {%- elsif section.settings.shorts_label != blank -%}
      <a class="alp-chip" href="{{ section.settings.shorts_fallback_url | default: '#' }}">{{ section.settings.shorts_label | escape }} <span class="alp-glyph">✦</span></a>
    {%- endif -%}
    {%- if section.settings.map_label != blank -%}
      {%- comment -%} Mobile keeps the hero to a single CTA (the shorts chip); the map chip only shows from tablet up. {%- endcomment -%}
      <a class="alp-chip alp-hero__cta-map" href="{{ section.settings.map_url | default: 'https://map.bushriding.cc' }}">{{ section.settings.map_label | escape }}</a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_scroll_cue -%}
    {%- comment -%}
      The page no longer ends at the fold, so say so. Decorative: it repeats
      the scroll affordance the scrollbar already gives, and announcing it
      would just be noise.
    {%- endcomment -%}
    <svg class="alp-hero__cue" viewBox="0 0 12 64" aria-hidden="true" focusable="false">
      <path d="M6 0 V54" />
      <path d="M1.5 48 L6 58 L10.5 48" />
    </svg>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Bush Riding hero",
  "tag": "div",
  "settings": [
    {
      "type": "url",
      "id": "video_url",
      "label": "Background clip URL",
      "info": "A direct mp4/mov file URL. Takes priority over the image, which becomes its poster."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Used on its own when there is no clip, and as the clip's poster when there is."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Separate poster image",
      "info": "Only needed when the clip should show a different still to the hero image."
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Show the scroll cue",
      "default": true
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show the wordmark over the photo",
      "default": true
    },
    {
      "type": "select",
      "id": "wordmark_tone",
      "label": "Wordmark tone",
      "options": [
        { "value": "bone", "label": "Bone (default over photography)" },
        { "value": "olive", "label": "Olive" },
        { "value": "sage", "label": "Sage" },
        { "value": "khaki", "label": "Khaki" },
        { "value": "mist", "label": "Mist" },
        { "value": "flare", "label": "Flare" },
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" }
      ],
      "default": "bone"
    },
    {
      "type": "image_picker",
      "id": "wordmark_image",
      "label": "Wordmark image override",
      "info": "Leave blank to use the shipped bone wordmark artwork above."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "product",
      "id": "shorts_product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "shorts_label",
      "label": "Product button label",
      "default": "Bush Riding Shorts"
    },
    {
      "type": "url",
      "id": "shorts_fallback_url",
      "label": "Product button URL (if no product picked)"
    },
    {
      "type": "text",
      "id": "map_label",
      "label": "Map button label",
      "default": "BUSH MAP™"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Map button URL",
      "info": "Defaults to https://map.bushriding.cc when blank."
    }
  ],
  "presets": [
    { "name": "Bush Riding hero" }
  ]
}
{% endschema %}
