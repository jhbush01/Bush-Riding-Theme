{%- comment -%}
  Home hero (D01 / M02) — full-bleed clip or photo under a flat olive scrim
  (.38), the bone wordmark centred with "Made for the detour." beneath.
  720px tall on desktop; on a phone it fills the screen below the header.

  The clip is deferred through alpine.js (data-alp-video) and the photo is its
  poster. A separate phone image lets the portrait crop differ.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: img
-%}
<section class="alp alp-hero">
  <div class="alp-hero__media">
    {%- if section.settings.video_url != blank -%}
      <video
        class="alp-fill"
        data-alp-video="{{ section.settings.video_url }}"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        {% if img != blank %}poster="{{ img | image_url: width: 1800 }}"{% endif %}
      ></video>
    {%- elsif img != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 800 }} 800w, {{ img_m | image_url: width: 1200 }} 1200w" sizes="100vw">
        {%- endif -%}
        {{ img | image_url: width: 3000 | image_tag: class: 'alp-fill', loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1800, 2400, 3000', sizes: '100vw', alt: img.alt | default: '' }}
      </picture>
    {%- endif -%}
  </div>
  <div class="alp-hero__scrim" aria-hidden="true"></div>
  <div class="alp-hero__centre">
    {%- if section.settings.show_wordmark -%}
      <img class="alp-hero__mark" src="{{ 'wordmark-' | append: section.settings.wordmark_tone | append: '.svg' | asset_url }}" alt="" width="1273" height="543" loading="eager">
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}
      <p class="alp-hero__tagline">{{ section.settings.tagline | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home hero",
  "tag": "div",
  "settings": [
    { "type": "url", "id": "video_url", "label": "Clip URL", "info": "A direct mp4 file. Takes priority over the image, which becomes its poster." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image", "info": "Optional portrait crop. Leave empty to use the image above." },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show the wordmark", "default": true },
    {
      "type": "select", "id": "wordmark_tone", "label": "Wordmark tone", "default": "bone",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "olive", "label": "Olive" },
        { "value": "white", "label": "White" }
      ]
    },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Made for the detour." }
  ],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}
