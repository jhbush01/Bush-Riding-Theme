{%- comment -%}
  Help strip (phones) — a few short reassurances with a line icon each:
  questions, shipping, returns. Each block links somewhere real or isn't
  shown: "policy" blocks need that policy set in Settings → Policies, and a
  block with no text is skipped, so nothing here promises what the store
  doesn't offer.

  Phones only (CLAUDE.md rule 6) — desktop shows nothing for this section.
{%- endcomment -%}
{%- capture rows -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign href = block.settings.url
      case block.settings.link
        when 'contact'
          if pages['contact'] != blank
            assign href = pages['contact'].url
          elsif shop.email != blank
            assign href = 'mailto:' | append: shop.email
          endif
        when 'shipping'
          assign href = shop.shipping_policy.url
        when 'returns'
          assign href = shop.refund_policy.url
      endcase
    -%}
    {%- if block.settings.title == blank or href == blank -%}{%- continue -%}{%- endif -%}
    <div class="alp-help__row" {{ block.shopify_attributes }}>
      <span class="alp-help__icon" aria-hidden="true">
        {%- case block.settings.icon -%}
          {%- when 'box' -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/></svg>
          {%- when 'return' -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 4 11l5 5"/><path d="M4 11h11a5 5 0 0 1 0 10h-3"/></svg>
          {%- else -%}
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6"/><circle cx="12" cy="17.2" r=".6" fill="currentColor"/></svg>
        {%- endcase -%}
      </span>
      <div class="alp-help__text">
        <p class="alp-help__title">{{ block.settings.title | escape }}</p>
        {%- if block.settings.text != blank -%}<p class="alp-help__body">{{ block.settings.text | escape }}</p>{%- endif -%}
        <a class="alp-help__link" href="{{ href }}">{{ block.settings.link_label | default: 'Find out more' | escape }}</a>
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}
{%- if rows != blank -%}
  <section class="alp alp-m alp-help">{{ rows }}</section>
{%- endif -%}

{% schema %}
{
  "name": "Help strip (phones)",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "paragraph", "content": "Phones only. A row only shows when it has a title and somewhere to link — a shipping or returns row needs that policy set in Settings → Policies." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "question",
          "options": [
            { "value": "question", "label": "Question" },
            { "value": "box", "label": "Parcel" },
            { "value": "return", "label": "Return arrow" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        {
          "type": "select", "id": "link", "label": "Links to", "default": "contact",
          "options": [
            { "value": "contact", "label": "Contact page (or the store email)" },
            { "value": "shipping", "label": "Shipping policy" },
            { "value": "returns", "label": "Refund policy" },
            { "value": "url", "label": "Link below" }
          ]
        },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "Find out more" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Help strip (phones)",
      "blocks": [
        { "type": "row", "settings": { "icon": "question", "title": "Questions about the kit?", "text": "Ask us anything. We ride in it every week.", "link": "contact", "link_label": "Get in touch" } },
        { "type": "row", "settings": { "icon": "box", "title": "Shipping", "text": "Where it goes and how long it takes.", "link": "shipping", "link_label": "Shipping details" } },
        { "type": "row", "settings": { "icon": "return", "title": "Returns", "text": "Wrong size? Here's how we sort it.", "link": "returns", "link_label": "Returns" } }
      ]
    }
  ]
}
{% endschema %}
