{%- comment -%}
  Bush Riding header — two deliberately different layouts (CLAUDE.md rule 6).

  Desktop and tablet: an 84px bone bar. Wordmark · Shop · Bush Map · Rides,
  then local time and weather, Search, Cart (n). Shop, Bush Map and Rides
  open full-width menus under the bar on click or tap (iPads have no hover)
  and, with a mouse, on hover; Search opens its overlay the same way. A menu
  stays while the pointer is over the header or the panel. Without script
  the nav links are plain links to /collections, the map and the rides page.

  Phone (M01): a 56px bar. Wordmark, then Search · Cart (n). The menu opens
  from a round button at the bottom right (thumb reach; drag it left) and rises as a sheet
  from the bottom with the page dimmed; swipe it down or tap the page to
  close: Shop expanded with its
  categories, Bush Map and Rides expanding the same way, About, and local
  time, weather and currency at its foot.

  Time, weather, routes and the ride are filled by alpine.js; each piece stays
  hidden until it has something true to say.
{%- endcomment -%}
{%- liquid
  capture rides_url
    render 'alp-link', to: 'rides'
  endcapture
  capture about_url
    render 'alp-link', to: 'about'
  endcapture
  capture bush_map_url
    render 'alp-link', to: 'bush_map'
  endcapture
  capture map_url
    render 'alp-link', to: 'map'
  endcapture
  capture submit_url
    render 'alp-link', to: 'submit'
  endcapture
  capture api_url
    render 'alp-link', to: 'api'
  endcapture
  assign shop_url = routes.all_products_collection_url

  assign here = ''
  case template.name
    when 'index'
      assign here = 'home'
    when 'collection', 'product', 'list-collections'
      assign here = 'shop'
    when 'search'
      assign here = 'search'
    when 'cart'
      assign here = 'cart'
    when 'blog', 'article'
      assign here = 'rides'
    when 'page'
      if page.url == rides_url
        assign here = 'rides'
      elsif page.url == bush_map_url
        assign here = 'map'
      elsif page.url == about_url
        assign here = 'about'
      endif
  endcase
  assign wordmark_alt = section.settings.wordmark | default: shop.name
-%}

<header
  class="alp alp-hd"
  data-alp-header
  data-alp-api="{{ api_url | escape }}"
  data-alp-map="{{ map_url | escape }}"
  data-alp-region="{{ settings.alp_near_region | escape }}"
  data-alp-tz="{{ settings.alp_timezone | default: 'Australia/Brisbane' | escape }}"
  {% if settings.alp_weather %}data-alp-wx="{{ settings.alp_lat | escape }},{{ settings.alp_lon | escape }}"{% endif %}
>
  <div class="alp-hd__bar">
    <a class="alp-hd__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: wordmark_alt, loading: 'eager' }}
      {%- else -%}
        <img class="alp-hd__mark" src="{{ 'wordmark-olive.svg' | asset_url }}" alt="{{ wordmark_alt | escape }}" width="1273" height="543" loading="eager">
        <img class="alp-hd__mark alp-hd__mark--light" src="{{ 'wordmark-bone.svg' | asset_url }}" alt="" width="1273" height="543" loading="eager" aria-hidden="true">
      {%- endif -%}
    </a>

    <nav class="alp-hd__nav alp-d" aria-label="Primary">
      <a
        class="alp-hd__link{% if here == 'shop' %} is-on{% endif %}"
        href="{{ shop_url }}"
        data-alp-toggle="alp-shopmenu"
        data-alp-hover
        aria-expanded="false"
        aria-controls="alp-shopmenu"
      >Shop</a>
      <a
        class="alp-hd__link{% if here == 'map' %} is-on{% endif %}"
        href="{{ map_url }}"
        data-alp-toggle="alp-mapmenu"
        data-alp-hover
        aria-expanded="false"
        aria-controls="alp-mapmenu"
      >Bush Map</a>
      <a
        class="alp-hd__link{% if here == 'rides' %} is-on{% endif %}"
        href="{{ rides_url }}"
        data-alp-toggle="alp-ridesmenu"
        data-alp-hover
        aria-expanded="false"
        aria-controls="alp-ridesmenu"
        {% if here == 'rides' %}aria-current="page"{% endif %}
      >Rides</a>
    </nav>

    <span class="alp-hd__spacer"></span>

    <span class="alp-hd__now alp-d" aria-label="Local time and weather">
      <span data-alp-clock>{{ 'now' | date: '%H:%M' }}</span> <span data-alp-tz-label>{{ settings.alp_tz_label | escape }}</span><span data-alp-wx-wrap hidden> · <span data-alp-wx-text></span></span>
    </span>

    <a
      class="alp-hd__link{% if here == 'search' %} is-on{% endif %}"
      href="{{ routes.search_url }}"
      data-alp-toggle="alp-searchmenu"
      data-alp-hover
      aria-expanded="false"
      aria-controls="alp-searchmenu"
    >Search</a>
    <a class="alp-hd__link{% if here == 'cart' %} is-on{% endif %}" href="{{ routes.cart_url }}" data-alp-open-cart>Cart (<span data-alp-cart-count>{{ cart.item_count }}</span>)</a>

    {%- comment -%}
      Phones: the menu button is a round button fixed at the bottom right (draggable), in
      thumb reach, and the menu rises from the bottom (trial, Oct 2026). It
      sits above the product page's buy bar when there is one.
    {%- endcomment -%}
    <button class="alp-hd__burger alp-fab alp-m" type="button" data-alp-toggle="alp-menu" aria-expanded="false" aria-controls="alp-menu" aria-label="Menu">
      <svg class="alp-hd__icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="alp-hd__icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  {%- comment -%}
    ── Nav menus (desktop and tablet): Shop, Bush Map, Rides ─────────────
    Full-width panels under the bar, one pattern for all three: bold main
    links, then labelled columns, one photo at the right (header settings).
    Tapping or clicking a nav link opens its panel — it doesn't navigate —
    so iPads, which have no hover, get the menu too; a mouse also opens it
    on hover. The pages themselves are the first link in each panel.
  {%- endcomment -%}
  {%- liquid
    assign sp = section.settings.shop_product
    if sp == blank
      assign sp = collections['bush-riding-launch'].products.first | default: collections.all.products.first
    endif
    assign life_url = section.settings.shop_image_link.url | default: shop_url
    capture size_url
      render 'alp-link', to: 'size_guide'
    endcapture
    capture mega_collections
      render 'alp-shop-links', variant: 'collections'
    endcapture
  -%}
  <div class="alp-mega alp-d" id="alp-shopmenu" data-alp-panel hidden>
    <nav class="alp-mega__cols" aria-label="Shop">
      <div class="alp-mega__col alp-mega__col--lead">
        <a class="alp-mega__lead" href="{{ shop_url }}">Shop all</a>
        {{ mega_collections }}
      </div>
      <div class="alp-mega__col">
        <p class="alp-mega__head">Kit</p>
        {%- render 'alp-shop-links', variant: 'types' -%}
      </div>
      <div class="alp-mega__col">
        <p class="alp-mega__head">Help</p>
        {%- if size_url != blank -%}<a class="alp-cats__item" href="{{ size_url }}">Size guide</a>{%- endif -%}
        {%- if shop.shipping_policy != blank -%}<a class="alp-cats__item" href="{{ shop.shipping_policy.url }}">Shipping</a>{%- endif -%}
        {%- if shop.refund_policy != blank -%}<a class="alp-cats__item" href="{{ shop.refund_policy.url }}">Returns</a>{%- endif -%}
        {%- if pages['contact'] != blank -%}
          <a class="alp-cats__item" href="{{ pages['contact'].url }}">Contact us</a>
        {%- elsif shop.email != blank -%}
          <a class="alp-cats__item" href="mailto:{{ shop.email }}">Contact us</a>
        {%- endif -%}
      </div>
    </nav>
    {%- if section.settings.shop_image != blank -%}
      <a class="alp-mega__photo" href="{{ life_url }}" tabindex="-1">
        {{ section.settings.shop_image | image_url: width: 800 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '400, 600, 800', sizes: '280px', alt: '' }}
        {%- if section.settings.shop_image_label != blank -%}
          <span class="alp-mega__label">{{ section.settings.shop_image_label | escape }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%}
    ── Search panel (desktop and phone) ──────────────────────────────────
    An overlay under the bar, not a page — on a phone it fills the screen
    below the bar. Before typing: Most popular — the
    product, two routes and the next ride. As you type: products from
    Shopify's predictive search (rendered by the alpine-search-results
    section, so prices are Liquid's), routes and rides from the map feeds.
    Enter goes to the full /search page.
  {%- endcomment -%}
  <div class="alp-searchmenu" id="alp-searchmenu" data-alp-panel hidden>
    <form class="alp-search__form alp-searchmenu__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="alp-vh" for="AlpSearchMenu">Search</label>
      <input
        class="alp-search__input"
        id="AlpSearchMenu"
        type="search"
        name="q"
        placeholder="Search shorts, routes and rides"
        autocomplete="off"
        data-alp-live-search
      >
      <input type="hidden" name="type" value="product">
      <button class="alp-search__go" type="submit">Search</button>
    </form>
    <div class="alp-searchmenu__body" data-alp-ls-popular>
      <p class="alp-searchmenu__head">Most popular</p>
      <div class="alp-grid4 alp-searchmenu__grid" data-alp-popular>
        {%- if sp != blank -%}{%- render 'alp-card', product: sp, quick: false -%}{%- endif -%}
      </div>
    </div>
    <div class="alp-searchmenu__body alp-searchmenu__results" data-alp-ls-results hidden>
      <div class="alp-searchmenu__col">
        <p class="alp-over">Products</p>
        <div data-alp-ls-products></div>
      </div>
      <div class="alp-searchmenu__col">
        <p class="alp-over">Routes · Bush Map™</p>
        <div data-alp-ls-routes></div>
      </div>
      <div class="alp-searchmenu__col">
        <p class="alp-over">Rides</p>
        <div data-alp-ls-rides></div>
      </div>
    </div>
  </div>

  {%- comment -%} Bush Map: the map and its pages, then routes near us (alpine.js). {%- endcomment -%}
  <div class="alp-mega alp-d" id="alp-mapmenu" data-alp-panel hidden>
    <nav class="alp-mega__cols" aria-label="Bush Map">
      <div class="alp-mega__col alp-mega__col--lead">
        <a class="alp-pill" href="{{ map_url }}">Open the map <span aria-hidden="true">→</span></a>
        <a class="alp-cats__item" href="{{ map_url }}/routes/">Every route</a>
        <a class="alp-cats__item" href="{{ map_url }}/events/">Events</a>
        <a class="alp-cats__item" href="{{ submit_url }}">Submit a route</a>
        {%- if bush_map_url != blank and bush_map_url != map_url -%}<a class="alp-cats__item" href="{{ bush_map_url }}">About Bush Map™</a>{%- endif -%}
      </div>
      <div class="alp-mega__col alp-mega__col--wide">
        <p class="alp-mega__head">Near you<span data-alp-near-label>{% if settings.alp_near_region != blank %} · {{ settings.alp_near_region | escape }}{% endif %}</span></p>
        <div class="alp-dd__list" data-alp-near-list><span class="alp-dd__quiet">Finding routes…</span></div>
      </div>
    </nav>
    {%- if section.settings.map_image != blank -%}
      <a class="alp-mega__photo" href="{{ map_url }}" tabindex="-1">
        {{ section.settings.map_image | image_url: width: 800 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '400, 600, 800', sizes: '280px', alt: '' }}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%}
    Rides — taller than the other two, to pull the eye: the rides page and
    Strava, the next rides (alpine.js), and at the right the three newest
    Ride Journal posts with their cover photos. The journal is the blog the
    Rides page reads (journal, else the store's first blog). With no posts
    yet, the Rides photo from the header settings shows instead.
  {%- endcomment -%}
  {%- liquid
    assign jblog = blogs['journal']
    if jblog == blank or jblog.handle == blank
      for b in blogs
        assign jblog = b
        break
      endfor
    endif
    assign jcount = 0
    if jblog != blank and jblog.handle != blank
      assign jcount = jblog.articles_count
    endif
  -%}
  <div class="alp-mega alp-mega--rides alp-d" id="alp-ridesmenu" data-alp-panel hidden>
    <nav class="alp-mega__cols" aria-label="Rides">
      <div class="alp-mega__col alp-mega__col--lead">
        <a class="alp-mega__lead" href="{{ rides_url }}">Upcoming Bush Rides</a>
        <a class="alp-mega__lead" href="{% if jcount > 0 %}{{ jblog.url }}{% else %}{{ rides_url }}{% endif %}">Ride Journal</a>
        {%- if settings.alp_strava_url != blank -%}
          <a class="alp-mega__lead" href="{{ settings.alp_strava_url }}" target="_blank" rel="noopener">Bush Riding Strava Club</a>
        {%- endif -%}
      </div>
      <div class="alp-mega__col">
        <p class="alp-mega__head">Upcoming Bush Rides</p>
        <div class="alp-dd__list" data-alp-rides-list><span class="alp-dd__quiet">Finding rides…</span></div>
      </div>
    </nav>
    {%- if jcount > 0 -%}
      <div class="alp-mega__journal">
        <p class="alp-mega__head"><a href="{{ jblog.url }}">Ride Journal</a></p>
        <div class="alp-mega__posts">
          {%- for a in jblog.articles limit: 3 -%}
            <a class="alp-mega__post" href="{{ a.url }}">
              <span class="alp-mega__postimg">
                {%- if a.image != blank -%}
                  {{ a.image | image_url: width: 600 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '300, 450, 600', sizes: '240px', alt: '' }}
                {%- endif -%}
              </span>
              <span class="alp-mega__postdate">{{ a.published_at | date: '%-d %B %Y' }}</span>
              <span class="alp-mega__posttitle">{{ a.title | escape }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- elsif section.settings.rides_image != blank -%}
      <a class="alp-mega__photo" href="{{ rides_url }}" tabindex="-1">
        {{ section.settings.rides_image | image_url: width: 800 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '400, 600, 800', sizes: '280px', alt: '' }}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%} ── M01 · Menu sheet (phones) ────────────────────────────── {%- endcomment -%}
  <div class="alp-menu alp-m" id="alp-menu" data-alp-panel data-alp-swipe-close hidden>
    <span class="alp-menu__grab" aria-hidden="true"></span>
    <nav class="alp-menu__nav" aria-label="Menu">
      <details class="alp-menu__group">
        <summary class="alp-menu__row">Shop <span class="alp-menu__pm" aria-hidden="true"></span></summary>
        <div class="alp-menu__sub alp-cats">
          {%- render 'alp-shop-links', variant: 'list', menu_link: true -%}
        </div>
      </details>
      <details class="alp-menu__group">
        <summary class="alp-menu__row">Bush Map <span class="alp-menu__pm" aria-hidden="true"></span></summary>
        <div class="alp-menu__sub alp-cats">
          <a class="alp-pill" href="{{ map_url }}" data-alp-close>Open the map <span aria-hidden="true">→</span></a>
          <a class="alp-cats__item" href="{{ map_url }}/routes/" data-alp-close>Every route</a>
          <a class="alp-cats__item" href="{{ map_url }}/events/" data-alp-close>Events</a>
          <a class="alp-cats__item" href="{{ submit_url }}" data-alp-close>Submit a route</a>
          {%- if bush_map_url != blank and bush_map_url != map_url -%}<a class="alp-cats__item" href="{{ bush_map_url }}" data-alp-close>About Bush Map™</a>{%- endif -%}
        </div>
      </details>
      <details class="alp-menu__group">
        <summary class="alp-menu__row">Rides <span class="alp-menu__pm" aria-hidden="true"></span></summary>
        <div class="alp-menu__sub alp-cats">
          <a class="alp-cats__item" href="{{ rides_url }}" data-alp-close>Upcoming Bush Rides</a>
          <a class="alp-cats__item" href="{% if jcount > 0 %}{{ jblog.url }}{% else %}{{ rides_url }}{% endif %}" data-alp-close>Ride Journal</a>
          {%- if settings.alp_strava_url != blank -%}
            <a class="alp-cats__item" href="{{ settings.alp_strava_url }}" target="_blank" rel="noopener" data-alp-close>Bush Riding Strava Club</a>
          {%- endif -%}
        </div>
      </details>
      {%- if about_url != blank -%}
        <a class="alp-menu__row" href="{{ about_url }}" data-alp-close>About <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </nav>
    <div class="alp-menu__foot">
      <p>
        Local time <span data-alp-clock>{{ 'now' | date: '%H:%M' }}</span><br>
        <span data-alp-place>{{ settings.alp_place_short | escape }}</span><span data-alp-wx-wrap hidden> · <span data-alp-wx-text></span></span>
      </p>
      {%- render 'alp-currency', id: 'MenuCurrency' -%}
    </div>
  </div>
</header>

<div class="alp-scrim" data-alp-scrim hidden></div>

{% schema %}
{
  "name": "Bush Riding header",
  "tag": "div",
  "class": "alp-hd-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the olive wordmark that ships with the theme." },
    { "type": "text", "id": "wordmark", "label": "Logo alt text", "default": "Bush Riding™" },
    { "type": "header", "content": "Shop dropdown (desktop)" },
    { "type": "product", "id": "shop_product", "label": "Product", "info": "Leads Most popular in the search panel. Leave empty to use the first product in the store." },
    { "type": "image_picker", "id": "shop_image", "label": "Photo", "info": "Portrait works best. Leave empty for a links-only dropdown." },
    { "type": "text", "id": "shop_image_label", "label": "Lifestyle caption", "default": "Shorts" },
    { "type": "collection", "id": "shop_image_link", "label": "Lifestyle photo links to", "info": "Leave empty to go to all products." },
    { "type": "header", "content": "Bush Map dropdown (desktop)" },
    { "type": "image_picker", "id": "map_image", "label": "Photo", "info": "Portrait works best. Leave empty for a links-only dropdown." },
    { "type": "header", "content": "Rides dropdown (desktop)" },
    { "type": "image_picker", "id": "rides_image", "label": "Photo", "info": "Shown only until the Ride Journal has a post — then its three newest posts take this spot." },
    { "type": "paragraph", "content": "Pages, map links, time zone and weather are set in Theme settings → Bush Riding." }
  ]
}
{% endschema %}
