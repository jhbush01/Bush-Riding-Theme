{%- comment -%}
  Bush Riding header — two deliberately different layouts (CLAUDE.md rule 6).

  Desktop (D01–D10): an 84px bone bar. Wordmark · Shop · Bush Map · Rides,
  then local time and weather, Search, Cart (n). Shop, Bush Map and Search
  each open a panel under the bar on hover or focus (Shop and Search on click
  too), which stays while the pointer is over the header or the panel.
  Clicking Bush Map goes to the map itself. Bush Map (D08): mini-map, the
  routes near us from the routes worker, the next ride, Open the map and
  Submit a route. Without script they are plain links to /collections, the
  map and /search.

  Phone (M01): a 56px bar. Wordmark, then Search · Cart (n) · menu. The menu
  drops as a sheet under the bar with the page dimmed: Shop expanded with its
  categories, Bush Map / Rides / About, and local time, weather and currency
  at its foot.

  Time, weather, routes and the ride are filled by alpine.js; each piece stays
  hidden until it has something true to say.
{%- endcomment -%}
{%- liquid
  capture rides_url
    render 'alp-link', to: 'rides'
  endcapture
  capture about_url
    render 'alp-link', to: 'about'
  endcapture
  capture bush_map_url
    render 'alp-link', to: 'bush_map'
  endcapture
  capture map_url
    render 'alp-link', to: 'map'
  endcapture
  capture submit_url
    render 'alp-link', to: 'submit'
  endcapture
  capture api_url
    render 'alp-link', to: 'api'
  endcapture
  assign shop_url = routes.all_products_collection_url

  assign here = ''
  case template.name
    when 'index'
      assign here = 'home'
    when 'collection', 'product', 'list-collections'
      assign here = 'shop'
    when 'search'
      assign here = 'search'
    when 'cart'
      assign here = 'cart'
    when 'blog', 'article'
      assign here = 'rides'
    when 'page'
      if page.url == rides_url
        assign here = 'rides'
      elsif page.url == bush_map_url
        assign here = 'map'
      elsif page.url == about_url
        assign here = 'about'
      endif
  endcase
  assign wordmark_alt = section.settings.wordmark | default: shop.name
-%}

<header
  class="alp alp-hd"
  data-alp-header
  data-alp-api="{{ api_url | escape }}"
  data-alp-map="{{ map_url | escape }}"
  data-alp-region="{{ settings.alp_near_region | escape }}"
  data-alp-tz="{{ settings.alp_timezone | default: 'Australia/Brisbane' | escape }}"
  {% if settings.alp_weather %}data-alp-wx="{{ settings.alp_lat | escape }},{{ settings.alp_lon | escape }}"{% endif %}
>
  <div class="alp-hd__bar">
    <a class="alp-hd__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: wordmark_alt, loading: 'eager' }}
      {%- else -%}
        <img src="{{ 'wordmark-olive.svg' | asset_url }}" alt="{{ wordmark_alt | escape }}" width="1273" height="543" loading="eager">
      {%- endif -%}
    </a>

    <nav class="alp-hd__nav alp-d" aria-label="Primary">
      <a
        class="alp-hd__link{% if here == 'shop' %} is-on{% endif %}"
        href="{{ shop_url }}"
        data-alp-toggle="alp-shopmenu"
        data-alp-hover
        data-alp-follow
        aria-expanded="false"
        aria-controls="alp-shopmenu"
      >Shop</a>
      <a
        class="alp-hd__link{% if here == 'map' %} is-on{% endif %}"
        href="{{ map_url }}"
        data-alp-toggle="alp-mapmenu"
        data-alp-hover
        data-alp-follow
        aria-expanded="false"
        aria-controls="alp-mapmenu"
      >Bush Map</a>
      <a class="alp-hd__link{% if here == 'rides' %} is-on{% endif %}" href="{{ rides_url }}"{% if here == 'rides' %} aria-current="page"{% endif %}>Rides</a>
    </nav>

    <span class="alp-hd__spacer"></span>

    <span class="alp-hd__now alp-d" aria-label="Local time and weather">
      <span data-alp-clock>{{ 'now' | date: '%H:%M' }}</span> {{ settings.alp_tz_label | escape }}<span data-alp-wx-wrap hidden> · <span data-alp-wx-text></span></span>
    </span>

    <a
      class="alp-hd__link{% if here == 'search' %} is-on{% endif %}"
      href="{{ routes.search_url }}"
      data-alp-toggle="alp-searchmenu"
      data-alp-hover
      aria-expanded="false"
      aria-controls="alp-searchmenu"
    >Search</a>
    <a class="alp-hd__link{% if here == 'cart' %} is-on{% endif %}" href="{{ routes.cart_url }}" data-alp-open-cart>Cart (<span data-alp-cart-count>{{ cart.item_count }}</span>)</a>

    <button class="alp-hd__burger alp-m" type="button" data-alp-toggle="alp-menu" aria-expanded="false" aria-controls="alp-menu" aria-label="Menu">
      <svg class="alp-hd__icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="alp-hd__icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  {%- comment -%}
    ── Shop panel (desktop) ──────────────────────────────────────────────
    A small dropdown, not a page: the collections, then the product types
    (each a page of its own), and one photo. Clicking Shop itself opens the
    whole shop. Phones get the same links in the menu sheet.
  {%- endcomment -%}
  {%- liquid
    assign sp = section.settings.shop_product
    if sp == blank
      assign sp = collections['bush-riding-launch'].products.first | default: collections.all.products.first
    endif
    assign life_url = section.settings.shop_image_link.url | default: shop_url
  -%}
  <div class="alp-shopmenu alp-d" id="alp-shopmenu" data-alp-panel hidden>
    <nav class="alp-shopmenu__links" aria-label="Shop">
      {%- render 'alp-shop-links', variant: 'drop' -%}
    </nav>
    <a class="alp-shopmenu__photo" href="{{ life_url }}">
      {%- if section.settings.shop_image != blank -%}
        {{ section.settings.shop_image | image_url: width: 800 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '400, 600, 800', sizes: '240px', alt: '' }}
      {%- endif -%}
      {%- if section.settings.shop_image_label != blank -%}
        <span class="alp-shop__label alp-shop__label--bone">{{ section.settings.shop_image_label | escape }}</span>
      {%- endif -%}
    </a>
  </div>

  {%- comment -%}
    ── Search panel (desktop and phone) ──────────────────────────────────
    An overlay under the bar, not a page — on a phone it fills the screen
    below the bar. Before typing: Most popular — the
    product, two routes and the next ride. As you type: products from
    Shopify's predictive search (rendered by the alpine-search-results
    section, so prices are Liquid's), routes and rides from the map feeds.
    Enter goes to the full /search page.
  {%- endcomment -%}
  <div class="alp-searchmenu" id="alp-searchmenu" data-alp-panel hidden>
    <form class="alp-search__form alp-searchmenu__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="alp-vh" for="AlpSearchMenu">Search</label>
      <input
        class="alp-search__input"
        id="AlpSearchMenu"
        type="search"
        name="q"
        placeholder="Search shorts, routes and rides"
        autocomplete="off"
        data-alp-live-search
      >
      <input type="hidden" name="type" value="product">
      <button class="alp-search__go" type="submit">Search</button>
    </form>
    <div class="alp-searchmenu__body" data-alp-ls-popular>
      <p class="alp-searchmenu__head">Most popular</p>
      <div class="alp-grid4 alp-searchmenu__grid" data-alp-popular>
        {%- if sp != blank -%}{%- render 'alp-card', product: sp, quick: false -%}{%- endif -%}
      </div>
    </div>
    <div class="alp-searchmenu__body alp-searchmenu__results" data-alp-ls-results hidden>
      <div class="alp-searchmenu__col">
        <p class="alp-over">Products</p>
        <div data-alp-ls-products></div>
      </div>
      <div class="alp-searchmenu__col">
        <p class="alp-over">Routes · Bush Map™</p>
        <div data-alp-ls-routes></div>
      </div>
      <div class="alp-searchmenu__col">
        <p class="alp-over">Rides</p>
        <div data-alp-ls-rides></div>
      </div>
    </div>
  </div>

  {%- comment -%} ── D08 · Bush Map panel (desktop) ───────────────────────── {%- endcomment -%}
  <div class="alp-mapmenu alp-d" id="alp-mapmenu" data-alp-panel hidden>
    <div class="alp-mapmenu__map">
      {%- if section.settings.map_image != blank -%}
        {{ section.settings.map_image | image_url: width: 1400 | image_tag: class: 'alp-fill', loading: 'lazy', sizes: '50vw', alt: '' }}
      {%- endif -%}
    </div>
    <div class="alp-mapmenu__body">
      <p class="alp-mapmenu__title">BUSH MAP™</p>
      <p class="alp-mapmenu__tag">{{ section.settings.map_tagline | escape }}</p>
      <p class="alp-over" data-alp-near-label>Near you · {{ settings.alp_near_region | escape }}</p>
      <ul class="alp-list" role="list" data-alp-near-list>
        <li class="alp-list__row alp-list__row--quiet">Finding routes…</li>
      </ul>
      <span class="alp-mapmenu__fill"></span>
      <div class="alp-pair">
        <a class="alp-btn" href="{{ map_url }}">Open the map</a>
        <a class="alp-btn alp-btn--line" href="{{ submit_url }}">Submit a route</a>
      </div>
    </div>
  </div>

  {%- comment -%} ── M01 · Menu sheet (phones) ────────────────────────────── {%- endcomment -%}
  <div class="alp-menu alp-m" id="alp-menu" data-alp-panel hidden>
    <nav class="alp-menu__nav" aria-label="Menu">
      <details class="alp-menu__group" open>
        <summary class="alp-menu__row">Shop <span class="alp-menu__pm" aria-hidden="true"></span></summary>
        <div class="alp-menu__sub alp-cats">
          {%- render 'alp-shop-links', variant: 'list', menu_link: true -%}
        </div>
      </details>
      <a class="alp-menu__row" href="{{ bush_map_url }}" data-alp-close>Bush Map <span aria-hidden="true">→</span></a>
      <a class="alp-menu__row" href="{{ rides_url }}" data-alp-close>Rides <span aria-hidden="true">→</span></a>
      {%- if about_url != blank -%}
        <a class="alp-menu__row" href="{{ about_url }}" data-alp-close>About <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </nav>
    <div class="alp-menu__foot">
      <p>
        Local time <span data-alp-clock>{{ 'now' | date: '%H:%M' }}</span><br>
        {{ settings.alp_place_short | escape }}<span data-alp-wx-wrap hidden> · <span data-alp-wx-text></span></span>
      </p>
      {%- render 'alp-currency', id: 'MenuCurrency' -%}
    </div>
  </div>
</header>

<div class="alp-scrim" data-alp-scrim hidden></div>

{% schema %}
{
  "name": "Bush Riding header",
  "tag": "div",
  "class": "alp-hd-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the olive wordmark that ships with the theme." },
    { "type": "text", "id": "wordmark", "label": "Logo alt text", "default": "Bush Riding™" },
    { "type": "header", "content": "Shop panel (desktop)" },
    { "type": "product", "id": "shop_product", "label": "Product", "info": "Leads Most popular in the search panel. Leave empty to use the first product in the store." },
    { "type": "image_picker", "id": "shop_image", "label": "Lifestyle photo" },
    { "type": "text", "id": "shop_image_label", "label": "Lifestyle caption", "default": "Shorts" },
    { "type": "collection", "id": "shop_image_link", "label": "Lifestyle photo links to", "info": "Leave empty to go to all products." },
    { "type": "header", "content": "Bush Map panel (desktop)" },
    { "type": "image_picker", "id": "map_image", "label": "Mini-map image", "info": "A still of the map around the near-you region." },
    { "type": "text", "id": "map_tagline", "label": "Tagline", "default": "Explore more with our curated gravel routes and events" },
    { "type": "paragraph", "content": "Pages, map links, time zone and weather are set in Theme settings → Bush Riding." }
  ]
}
{% endschema %}
