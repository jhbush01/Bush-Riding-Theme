{%- comment -%}
  The journal as a list of ride recaps — where "All recaps" on Rides goes.
{%- endcomment -%}
{%- paginate blog.articles by 8 -%}
  <section class="alp alp-blog">
    <header class="alp-pagehead">
      <h1 class="alp-pagehead__title">{{ section.settings.heading | default: blog.title | escape }}</h1>
    </header>
    {%- render 'alp-recaps', articles: blog.articles -%}
    {%- if paginate.pages > 1 -%}
      <nav class="alp-pages" aria-label="Pages">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Newer</a>{%- endif -%}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Older →</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Recaps",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recaps", "info": "Leave empty to use the blog's title." }
  ]
}
{% endschema %}
