{%- comment -%}
  Bush Riding footer — the same on every page (D11 desktop, M12 phone).
  Newsletter and country/region, four link columns (4-up desktop, 2×2 phone),
  the wordmark the full width of the page, and the copyright row.

  Each column takes a Shopify menu. Left empty, it falls back to the design's
  links — and only the ones that resolve (a policy or page that doesn't exist
  is left out rather than linked to a 404).
{%- endcomment -%}
{%- liquid
  capture rides_url
    render 'alp-link', to: 'rides'
  endcapture
  capture about_url
    render 'alp-link', to: 'about'
  endcapture
  capture map_url
    render 'alp-link', to: 'map'
  endcapture
  capture size_url
    render 'alp-link', to: 'size_guide'
  endcapture
-%}

<footer class="alp alp-ft">
  <div class="alp-ft__top">
    <div class="alp-ft__news">
      <p class="alp-ft__head">{{ section.settings.news_heading | escape }}</p>
      <p class="alp-ft__copy">{{ section.settings.news_copy | escape }}</p>
      {%- render 'alp-signup', id: 'FooterNewsletter', tags: 'newsletter', label: 'Subscribe' -%}
    </div>
    <div class="alp-ft__region alp-d">
      <p class="alp-ft__muted">Country / Region</p>
      {%- render 'alp-currency', id: 'FooterCurrency' -%}
    </div>
  </div>

  <div class="alp-ft__cols">
    {%- for block in section.blocks -%}
      <div class="alp-ft__col" {{ block.shopify_attributes }}>
        <p class="alp-ft__colhead">{{ block.settings.heading | escape }}</p>
        <ul role="list">
          {%- if block.settings.menu != blank -%}
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- case block.settings.preset -%}
              {%- when 'help' -%}
                {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping &amp; delivery</a></li>{%- endif -%}
                {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">Returns &amp; exchanges</a></li>{%- endif -%}
                {%- if size_url != blank -%}<li><a href="{{ size_url }}">Size guide</a></li>{%- endif -%}
              {%- when 'brand' -%}
                {%- if about_url != blank -%}<li><a href="{{ about_url }}">About</a></li>{%- endif -%}
                <li><a href="{{ rides_url }}">Rides</a></li>
                <li><a href="{{ map_url }}">Bush Map™</a></li>
              {%- when 'contact' -%}
                {%- if pages['contact'] != blank -%}<li><a href="{{ pages['contact'].url }}">Customer service</a></li>
                {%- elsif shop.email != blank -%}<li><a href="mailto:{{ shop.email }}">Customer service</a></li>{%- endif -%}
                {%- if settings.alp_instagram_url != blank -%}<li><a href="{{ settings.alp_instagram_url }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
                {%- if settings.alp_strava_url != blank -%}<li><a href="{{ settings.alp_strava_url }}" target="_blank" rel="noopener">Strava</a></li>{%- endif -%}
              {%- when 'legal' -%}
                {%- if shop.privacy_policy != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>{%- endif -%}
                {%- if shop.terms_of_service != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Terms of service</a></li>{%- endif -%}
                {%- if pages['accessibility'] != blank -%}<li><a href="{{ pages['accessibility'].url }}">Accessibility</a></li>{%- endif -%}
            {%- endcase -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <div class="alp-ft__mark">
    <img src="{{ 'wordmark-olive.svg' | asset_url }}" alt="" width="1273" height="543" loading="lazy">
  </div>

  <div class="alp-ft__base">
    <span>© Bush Riding™ {{ 'now' | date: '%Y' }}<span class="alp-d"> · {{ section.settings.signoff | escape }}</span></span>
    <span class="alp-m">{%- render 'alp-currency', id: 'FooterCurrencyPhone' -%}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Bush Riding footer",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "news_heading", "label": "Newsletter heading", "default": "Newsletter" },
    { "type": "text", "id": "news_copy", "label": "Newsletter line", "default": "We send the occasional route, nothing else." },
    { "type": "text", "id": "signoff", "label": "Sign-off after the copyright", "default": "Designed in Australia" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "HELP" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Leave empty to use the built-in links below." },
        {
          "type": "select",
          "id": "preset",
          "label": "Built-in links",
          "options": [
            { "value": "help", "label": "Help: shipping, returns, size guide" },
            { "value": "brand", "label": "Bush Riding: about, rides, map" },
            { "value": "contact", "label": "Contact: customer service, Instagram, Strava" },
            { "value": "legal", "label": "Legal: privacy, terms, accessibility" }
          ],
          "default": "help"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bush Riding footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "HELP", "preset": "help" } },
        { "type": "column", "settings": { "heading": "BUSH RIDING", "preset": "brand" } },
        { "type": "column", "settings": { "heading": "CONTACT", "preset": "contact" } },
        { "type": "column", "settings": { "heading": "LEGAL", "preset": "legal" } }
      ]
    }
  ]
}
{% endschema %}
