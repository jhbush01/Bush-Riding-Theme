{%- comment -%}
  Home product row — the products sitting straight on the page: no card
  ground, no frame, name and price left underneath, the second photo on
  hover (desktop). Three or four across on desktop, two on phones. Only real
  products; coming-soon categories live on their own pages.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign limit = section.settings.limit
  assign n = source.products.size | at_most: limit
  assign cols = n | at_most: 4 | at_least: 2
-%}
<section class="alp alp-prow" style="--cols: {{ cols }}">
  {%- if section.settings.heading != blank -%}
    <div class="alp-prow__head">
      <h2 class="alp-prow__title">{{ section.settings.heading | escape }}</h2>
      <a class="alp-prow__all" href="{{ source.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>
    </div>
  {%- endif -%}
  <div class="alp-prow__grid">
    {%- for p in source.products limit: limit -%}
      {%- render 'alp-card', product: p, look: 'bare', dots: section.settings.dots, sizes: '(min-width: 750px) 30vw, 50vw' -%}
    {%- else -%}
      <p class="alp-prow__empty">Products show here once they're published to the Online Store.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product row",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for every product." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "dots", "label": "Show colour dots", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Optional — the row works without one." },
    { "type": "text", "id": "link_label", "label": "Link beside the heading", "default": "Shop all" }
  ],
  "presets": [{ "name": "Product row" }]
}
{% endschema %}
