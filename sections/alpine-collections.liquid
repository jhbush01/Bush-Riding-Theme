{%- comment -%}
  /collections — every collection with products, as photo tiles. The shop
  itself is the header's Shop panel and the all-products page; this is just
  so the URL still lands somewhere useful.
{%- endcomment -%}
<section class="alp alp-colls">
  <header class="alp-pagehead">
    <h1 class="alp-pagehead__title">{{ section.settings.heading | escape }}</h1>
  </header>
  <div class="alp-grid4">
    {%- for c in collections -%}
      {%- if c.handle == 'frontpage' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign img = c.featured_image | default: c.products.first.featured_media.preview_image -%}
      <div class="alp-card">
        <a class="alp-card__media" href="{{ c.url }}" tabindex="-1" aria-hidden="true">
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 25vw, 50vw', alt: '' }}
          {%- endif -%}
        </a>
        <p class="alp-card__cap">
          <a class="alp-card__name" href="{{ c.url }}">{% if c.handle == 'all' %}All products{% else %}{{ c.title | escape }}{% endif %}</a>
          <span class="alp-card__stats">{{ c.products_count }} {% if c.products_count == 1 %}style{% else %}styles{% endif %}</span>
        </p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
