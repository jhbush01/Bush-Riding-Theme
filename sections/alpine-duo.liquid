{%- comment -%}
  Two photo panels side by side, each a link (D01 "Ride with us" | "Get the
  route. Join the bush.", M02 Rides | BUSH MAP™).

  Desktop: 560px tall, the line in bone over the photo with a white chip
  beneath. Phone: tall rounded cards in a swipe row (the next one peeks in),
  the line centred in bone with an outlined button carrying the chip text.

  A panel's link can be a URL, or one of the site's own destinations so it
  follows Theme settings when a page moves.
{%- endcomment -%}
{%- capture urls -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign url = block.settings.url
      case block.settings.to
        when 'rides'
          capture url
            render 'alp-link', to: 'rides'
          endcapture
        when 'map'
          capture url
            render 'alp-link', to: 'map'
          endcapture
        when 'bush_map'
          capture url
            render 'alp-link', to: 'bush_map'
          endcapture
        when 'about'
          capture url
            render 'alp-link', to: 'about'
          endcapture
      endcase
    -%}
    {{ url | default: '#' }}|
  {%- endfor -%}
{%- endcapture -%}
{%- assign url_list = urls | strip | split: '|' -%}

<section class="alp alp-duo alp-duo--links alp-d">
  {%- for block in section.blocks -%}
    {%- assign url = url_list[forloop.index0] | strip -%}
    <a class="alp-duo__panel alp-duo__panel--{{ block.settings.ground }}" href="{{ url | default: '#' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '400, 800, 1200, 1600', sizes: '50vw', alt: '' }}
      {%- endif -%}
      <span class="alp-duo__stack">
        {%- if block.settings.title != blank -%}
          <span class="alp-duo__title alp-d">{{ block.settings.title | escape }}</span>
        {%- endif -%}
        <span class="alp-chip alp-chip--strong">{{ block.settings.chip | escape }}</span>
      </span>
    </a>
  {%- endfor -%}
</section>

<section class="alp alp-m alp-mcards" data-alp-scroller>
  <div class="alp-mcards__track" data-alp-track>
    {%- for block in section.blocks -%}
      {%- assign url = url_list[forloop.index0] | strip -%}
      <a class="alp-mcard alp-duo__panel--{{ block.settings.ground }}" href="{{ url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '600, 900, 1200', sizes: '84vw', alt: '' }}
        {%- endif -%}
        <span class="alp-mcard__scrim" aria-hidden="true"></span>
        <span class="alp-mcard__body">
          {%- if block.settings.title != blank -%}<span class="alp-mcard__title">{{ block.settings.title | escape }}</span>{%- endif -%}
          <span class="alp-mcard__btn">{{ block.settings.chip | escape }}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Photo pair",
  "tag": "div",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select", "id": "ground", "label": "Ground behind the photo", "default": "bone",
          "options": [
            { "value": "bone", "label": "Bone" },
            { "value": "mist", "label": "Mist (map)" },
            { "value": "card", "label": "Card" }
          ]
        },
        { "type": "text", "id": "title", "label": "Line (desktop)", "default": "Ride with us" },
        { "type": "text", "id": "chip", "label": "Chip", "default": "Rides" },
        {
          "type": "select", "id": "to", "label": "Goes to", "default": "rides",
          "options": [
            { "value": "rides", "label": "Rides page" },
            { "value": "map", "label": "The map site" },
            { "value": "bush_map", "label": "Bush Map page" },
            { "value": "about", "label": "About page" },
            { "value": "url", "label": "Link below" }
          ]
        },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo pair",
      "blocks": [
        { "type": "panel", "settings": { "title": "Ride with us", "chip": "Rides", "to": "rides" } },
        { "type": "panel", "settings": { "title": "Get the route. Join the bush.", "chip": "BUSH MAP™", "to": "map", "ground": "mist" } }
      ]
    }
  ]
}
{% endschema %}
