{%- comment -%}
  The home page's shop band. One product, drawn two deliberately different
  ways (CLAUDE.md rule 6):

  Desktop (D01): a 640px 2-up — lifestyle photo with a caption | the product
  on its plain ground with name and price chips — then a 4-up 3:4 row: the
  featured product with Quick add, the store's other products, and — while
  there are fewer than four — more angles of the featured product. Only real
  products; coming-soon categories live on their own collection pages.

  Phone: a big centred heading, the store's products as a swipe row (centred
  name, price and colour dots, Quick add +), View all, then the lifestyle
  photo full bleed.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = collections['bush-riding-launch'].products.first | default: collections.all.products.first
  endif
  assign life = section.settings.lifestyle
  assign panel = section.settings.panel_image | default: p.featured_media.preview_image
  assign second = section.settings.second_image
  if second == blank and p.media.size > 1
    assign second = p.media[1].preview_image
  endif
  assign second_caption = p.title | append: section.settings.second_suffix
-%}
<section class="alp alp-homeshop">
  {%- comment -%} ── Desktop ── {%- endcomment -%}
  <div class="alp-d">
    <div class="alp-duo alp-duo--640">
      <div class="alp-duo__panel">
        {%- if life != blank -%}
          {{ life | image_url: width: 1600 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '800, 1200, 1600', sizes: '50vw', alt: life.alt | default: '' }}
        {%- endif -%}
        {%- if section.settings.lifestyle_caption != blank -%}
          <span class="alp-duo__caption">{{ section.settings.lifestyle_caption | escape }}</span>
        {%- endif -%}
      </div>
      <a class="alp-duo__panel alp-duo__panel--ground" href="{{ p.url | default: routes.all_products_collection_url }}">
        {%- if panel != blank -%}
          {{ panel | image_url: width: 1600 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '800, 1200, 1600', sizes: '50vw', alt: p.title | default: '' }}
        {%- endif -%}
        {%- if p != blank -%}
          <span class="alp-duo__chips">
            <span class="alp-chip alp-chip--strong">{{ p.title | escape }}</span>
            <span class="alp-chip">{{ p.price | money_without_trailing_zeros }}</span>
          </span>
        {%- endif -%}
      </a>
    </div>

    <div class="alp-grid4">
      {%- liquid
        assign shown = 0
        if p != blank
          render 'alp-card', product: p
          assign shown = 1
        endif
        for other in collections.all.products limit: 8
          if shown >= 4
            break
          endif
          if other.id == p.id
            continue
          endif
          render 'alp-card', product: other
          assign shown = shown | plus: 1
        endfor
        comment
          Fewer than four products: fill with the featured product's other
          photos — the second one is the chosen "second angle" if set.
        endcomment
        for m in p.media offset: 1
          if shown >= 4
            break
          endif
          assign angle = m.preview_image
          assign cap = p.title
          if forloop.first
            if second != blank
              assign angle = second
            endif
            assign cap = second_caption
          endif
          render 'alp-card', product: p, image: angle, caption: cap, quick: false
          assign shown = shown | plus: 1
        endfor
      -%}
    </div>
  </div>

  {%- comment -%}
    ── Phone ── a big centred heading, the products as a swipe row (one card
    centred while there's only one), View all, then the lifestyle photo full
    bleed. Each card keeps Quick add + (tap one of the three-tap checkout).
  {%- endcomment -%}
  <div class="alp-m alp-mhome">
    <h2 class="alp-mhome__title">{{ section.settings.mobile_heading | escape }}</h2>
    <div class="alp-hrow" data-alp-scroller>
      <div class="alp-hrow__track" data-alp-track>
        {%- liquid
          if p != blank
            render 'alp-card', product: p, look: 'centre', dots: true
          endif
          for other in collections.all.products limit: 9
            if other.id == p.id
              continue
            endif
            render 'alp-card', product: other, look: 'centre', dots: true
          endfor
        -%}
      </div>
    </div>
    <p class="alp-mhome__cta"><a class="alp-btn" href="{{ routes.all_products_collection_url }}">{{ section.settings.mobile_button | escape }}</a></p>
    {%- if life != blank -%}
      <div class="alp-mhome__photo">
        {{ life | image_url: width: 1400 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '600, 900, 1400', sizes: '100vw', alt: life.alt | default: '' }}
        {%- if section.settings.lifestyle_caption != blank -%}
          <span class="alp-duo__caption">{{ section.settings.lifestyle_caption | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home shop band",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use the first product in the store." },
    { "type": "image_picker", "id": "panel_image", "label": "Product panel image (desktop)", "info": "The product on a plain ground. Defaults to the product's first photo." },
    { "type": "image_picker", "id": "second_image", "label": "Second angle (desktop row)", "info": "Defaults to the product's second photo." },
    { "type": "text", "id": "second_suffix", "label": "Second angle caption suffix", "default": ", rear" },
    { "type": "image_picker", "id": "lifestyle", "label": "Lifestyle photo" },
    { "type": "text", "id": "lifestyle_caption", "label": "Lifestyle caption", "default": "On the long way home" },
    { "type": "text", "id": "mobile_heading", "label": "Phone heading", "default": "The shorts" },
    { "type": "text", "id": "mobile_button", "label": "Phone button", "default": "View all" }
  ],
  "presets": [{ "name": "Home shop band" }]
}
{% endschema %}
