{%- comment -%}
  Collection (D03 / D04 desktop, M04 / M05 phone).

  Category bar: View all · each product Type · next-drop types · then the
  collections (alp-shop-links). Products are grouped under their Type. At the right either
  at the right either "1 product" or — from the Theme settings threshold
  (6) up — Filters and Sort by. Filters and Sort do nothing for a handful of
  products, so they aren't drawn until they would.

  Intros: each product Type (and any collection) can have an Intro block —
  a full-bleed photo with the name, a short line and a few sentences — shown
  only at the top of that Type's or collection's own page. View all and the
  collections group their products under plain Type headings, never another
  page's intro. A collection with no Intro block uses its own image and
  description; a Type with none just starts with its products.
  Products: small cards, four across on desktop, two on phones, centred
  caption with the colour dots.

  Filters are Shopify's (Search & Discovery). Desktop drops them under the
  bar; on a phone the same form is a bottom sheet with accordions. "Show N
  results" is a live count — alpine.js re-asks this section for its count
  as the boxes change.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.alp_filter_threshold | default: 6
  assign show_tools = false
  if collection.all_products_count >= threshold
    assign show_tools = true
  endif

  assign active = 0
  for f in collection.filters
    assign active = active | plus: f.active_values.size
    if f.type == 'price_range'
      if f.min_value.value != blank or f.max_value.value != blank
        assign active = active | plus: 1
      endif
    endif
  endfor

  assign count = collection.products_count
  assign coming_soon = false
  if collection.all_products_count == 0 and collection.handle != 'all' and collection.current_type == blank
    assign coming_soon = true
  endif
  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign codes = section.settings.codes | newline_to_br | split: '<br />'
-%}

{%- paginate collection.products by 24 -%}
<section
  class="alp alp-cat"
  data-alp-cat
  data-alp-section="{{ section.id }}"
  data-alp-count="{{ count }}"
>
  {%- liquid
    comment
      The page's own intro: a Type page looks up its Type, a collection its
      handle; a collection without a block falls back to its image and
      description. The all-products page has none (its Types do).
    endcomment
    assign page_key = ''
    if collection.current_type != blank
      assign page_key = collection.current_type | downcase | strip
    elsif collection.handle != 'all'
      assign page_key = collection.handle | downcase
    endif
    assign page_block = nil
    if page_key != ''
      for b in section.blocks
        assign bk = b.settings.match | downcase | strip
        if bk == page_key
          assign page_block = b
          break
        endif
      endfor
    endif
    assign has_intro = false
  -%}
  {%- if coming_soon -%}
    {%- comment -%} Its Notify me page already carries the name and photo. {%- endcomment -%}
  {%- elsif page_block != nil -%}
    {%- assign intro_title = page_block.settings.title | default: collection.current_type | default: collection.title -%}
    {%- render 'alp-cat-intro', heading: 'h1', title: intro_title, tagline: page_block.settings.tagline, text: page_block.settings.text, image: page_block.settings.image, attrs: page_block.shopify_attributes, loading: 'eager' -%}
    {%- assign has_intro = true -%}
  {%- elsif collection.current_type == blank and collection.handle != 'all' and collection.image != blank -%}
    {%- assign intro_text = collection.description | strip_html | strip -%}
    {%- render 'alp-cat-intro', heading: 'h1', title: collection.title, text: intro_text, image: collection.image, loading: 'eager' -%}
    {%- assign has_intro = true -%}
  {%- endif -%}

  {%- unless has_intro -%}<h1 class="alp-vh">{{ collection.title | escape }}</h1>{%- endunless -%}

  {%- comment -%}
    Category bar, the phone's count + Filters row and the Filters panel stay
    pinned to the top once scrolled to; the header slides in above them on
    the way up (alpine.css, "alp-cat__head").
  {%- endcomment -%}
  <div class="alp-cat__head">
  <div class="alp-cat__bar">
    <nav class="alp-cats alp-cats--bar" aria-label="Categories">
      {%- render 'alp-shop-links', variant: 'bar' -%}
    </nav>
    <span class="alp-cat__spacer alp-d"></span>
    {%- if show_tools -%}
      <button class="alp-cat__tool alp-d" type="button" data-alp-toggle="alp-filters" aria-expanded="false" aria-controls="alp-filters">
        Filters{% if active > 0 %} ({{ active }}){% endif %}
      </button>
      <label class="alp-cat__sort alp-d">
        <span class="alp-vh">Sort by</span>
        <select name="sort_by" form="alp-filter-form" data-alp-autosubmit>
          {%- for o in collection.sort_options -%}
            <option value="{{ o.value | escape }}"{% if o.value == sort_by %} selected{% endif %}>{% if forloop.first %}Sort by: {% endif %}{{ o.name | escape }}</option>
          {%- endfor -%}
        </select>
      </label>
    {%- else -%}
      {%- unless coming_soon -%}<span class="alp-cat__count alp-d">{{ count }} {% if count == 1 %}product{% else %}products{% endif %}</span>{%- endunless -%}
    {%- endif -%}
  </div>

  {%- unless coming_soon -%}
  <div class="alp-cat__countrow alp-m">
    <span>{{ count }} {% if count == 1 %}product{% else %}products{% endif %}</span>
    {%- if show_tools -%}
      <button class="alp-chip alp-chip--line" type="button" data-alp-toggle="alp-filters" aria-expanded="false" aria-controls="alp-filters">
        Filters{% if active > 0 %} ({{ active }}){% endif %}
      </button>
    {%- endif -%}
  </div>
  {%- endunless -%}

  {%- if show_tools -%}
    <div class="alp-filters" id="alp-filters" data-alp-panel data-alp-sheet hidden>
      <form class="alp-filters__form" id="alp-filter-form" action="{{ collection.url }}" method="get" data-alp-filter-form>
        <div class="alp-sheet__grab alp-m" aria-hidden="true"></div>
        <div class="alp-sheet__head alp-m">
          <span>Filters</span>
          <button class="alp-x" type="button" data-alp-close aria-label="Close filters">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        <div class="alp-filters__groups">
          {%- for f in collection.filters -%}
            {%- assign is_size = false -%}
            {%- assign label_down = f.label | downcase -%}
            {%- if label_down contains 'size' -%}{%- assign is_size = true -%}{%- endif -%}
            <details class="alp-filters__group"{% if forloop.first or f.active_values.size > 0 %} open{% endif %}>
              <summary class="alp-filters__head">{{ f.label | escape }}<span class="alp-menu__pm alp-m" aria-hidden="true"></span></summary>
              {%- case f.type -%}
                {%- when 'price_range' -%}
                  <div class="alp-filters__price">
                    <label><span>From</span>
                      <input type="number" name="{{ f.min_value.param_name }}" value="{{ f.min_value.value | money_without_currency | remove: ',' }}" placeholder="0" min="0" inputmode="decimal">
                    </label>
                    <label><span>To</span>
                      <input type="number" name="{{ f.max_value.param_name }}" value="{{ f.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ f.range_max | money_without_currency | remove: ',' }}" min="0" inputmode="decimal">
                    </label>
                  </div>
                {%- else -%}
                  <div class="alp-filters__values{% if is_size %} alp-filters__values--sizes{% endif %}">
                    {%- for v in f.values -%}
                      {%- liquid
                        assign code = ''
                        for line in codes
                          assign pair = line | strip | split: ':'
                          if pair.size == 2
                            assign k = pair[0] | strip | downcase
                            assign vl = v.label | downcase
                            if k == vl
                              assign code = pair[1] | strip
                            endif
                          endif
                        endfor
                        assign dead = false
                        if v.count == 0 and v.active == false
                          assign dead = true
                        endif
                      -%}
                      <label class="alp-opt{% if is_size %} alp-opt--tile{% elsif code != blank %} alp-opt--code{% else %} alp-opt--box{% endif %}{% if dead %} is-dead{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ v.param_name }}"
                          value="{{ v.value }}"
                          {% if v.active %}checked{% endif %}
                          {% if dead %}disabled{% endif %}
                        >
                        {%- if is_size -%}
                          <span class="alp-opt__face">{{ v.label | escape }}</span>
                        {%- elsif code != blank -%}
                          <span class="alp-opt__code">{{ code | escape }}</span><span class="alp-opt__text">{{ v.label | escape }}</span>
                        {%- else -%}
                          <span class="alp-opt__box" aria-hidden="true"></span><span class="alp-opt__text">{{ v.label | escape }}</span>
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
              {%- endcase -%}
            </details>
          {%- endfor -%}
        </div>

        <div class="alp-filters__actions">
          <button class="alp-btn" type="submit" data-alp-filter-submit>Show {{ count }} {% if count == 1 %}result{% else %}results{% endif %}</button>
          <button class="alp-btn alp-btn--line alp-d" type="button" data-alp-close>Cancel</button>
          <a class="alp-btn alp-btn--line alp-m" href="{{ collection.url }}?sort_by={{ sort_by | url_encode }}">Clear</a>
        </div>
      </form>
    </div>
  {%- endif -%}

  </div>

  {%- if coming_soon -%}
    {%- comment -%}
      An empty collection is a category that hasn't landed: its page is the
      Notify me. Signups are tagged next-drop plus the collection's handle,
      so Admin → Customers can find everyone waiting for it.
    {%- endcomment -%}
    {%- assign soon_tags = 'next-drop, ' | append: collection.handle -%}
    {%- assign soon_img = collection.featured_image | default: section.settings.lifestyle -%}
    <div class="alp-soon">
      <div class="alp-soon__text">
        <span class="alp-badge alp-badge--flare">Next drop</span>
        <h2 class="alp-soon__title">{{ collection.title | escape }}</h2>
        <div class="alp-soon__body">
          {%- if collection.description != blank -%}{{ collection.description }}{%- else -%}<p>{{ section.settings.soon_line | escape }}</p>{%- endif -%}
        </div>
        {%- render 'alp-signup', id: 'ComingSoon', tags: soon_tags, label: 'Notify me', thanks: "Noted. You'll hear when they land." -%}
        <a class="alp-soon__back" href="{{ routes.all_products_collection_url }}">Shop what's here now</a>
      </div>
      <div class="alp-soon__photo">
        {%- if soon_img != blank -%}
          {{ soon_img | image_url: width: 1600 | image_tag: class: 'alp-fill', loading: 'eager', widths: '800, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
  <div class="alp-cat__tiles">
    {%- liquid
      comment
        Grouped by product Type (Shorts, …) — the store's own categories —
        unless someone has filtered, sorted, or is already on one type's
        page, where headings would only repeat what they chose.
      endcomment
      assign n = collection.products.size
      assign grouped = false
      if section.settings.group_by_type and active == 0 and collection.current_type == blank and collection.sort_by == blank and n > 0
        assign grouped = true
      endif
      assign card_sizes = '(min-width: 750px) 25vw, 50vw'
      assign i = 0
    -%}
    {%- if grouped -%}
      {%- for t in collection.all_types -%}
        {%- if t == blank -%}{%- continue -%}{%- endif -%}
        {%- assign in_type = collection.products | where: 'type', t -%}
        {%- if in_type.size == 0 -%}{%- continue -%}{%- endif -%}
        <h2 class="alp-cat__group">
          <span>{{ t | escape }}</span>
          <a href="{{ t | url_for_type }}">See all</a>
        </h2>
        {%- for product in in_type -%}
          {%- assign i = i | plus: 1 -%}
          {%- if i <= 4 -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
          {%- render 'alp-card', product: product, loading: ld, look: 'bare', dots: true, sizes: card_sizes -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- capture untyped -%}
        {%- for product in collection.products -%}
          {%- if product.type == blank -%}x{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if untyped != blank -%}
        <h2 class="alp-cat__group"><span>More</span></h2>
        {%- for product in collection.products -%}
          {%- if product.type != blank -%}{%- continue -%}{%- endif -%}
          {%- render 'alp-card', product: product, loading: 'lazy', look: 'bare', dots: true, sizes: card_sizes -%}
        {%- endfor -%}
      {%- endif -%}
    {%- else -%}
      {%- for product in collection.products -%}
        {%- if forloop.index <= 4 -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
        {%- render 'alp-card', product: product, loading: ld, look: 'bare', dots: true, sizes: card_sizes -%}
      {%- else -%}
        <p class="alp-cat__empty">Nothing here yet. {% if active > 0 %}<a href="{{ collection.url }}">Clear the filters</a>{% else %}<a href="{{ routes.all_products_collection_url }}">See everything</a>{% endif %}</p>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- endif -%}

  {%- if paginate.pages > 1 -%}
    <nav class="alp-pages" aria-label="Pages">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
      <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
    </nav>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "lifestyle", "label": "Coming-soon photo", "info": "Shown on an empty (coming-soon) collection's page when the collection has no image of its own." },
    { "type": "checkbox", "id": "group_by_type", "label": "Group products by Type", "default": true, "info": "Headings per product Type (Shorts, …) on all products and on collections. Off while a filter or sort is applied." },
    { "type": "text", "id": "soon_line", "label": "Coming-soon line", "default": "Coming in the next drop. Leave your email and we'll let you know the day they land.", "info": "Shown on an empty collection's page, above Notify me. A collection's own description replaces it." },
    {
      "type": "textarea", "id": "codes", "label": "Filter codes",
      "default": "Ultra-lightweight nylon shell: LW\nMoisture-wicking lining: MW\nRear zip pocket: ZP",
      "info": "One per line, \"Filter value: CODE\". Shown as the two-letter code tile in Filters."
    },
    { "type": "paragraph", "content": "Filters and Sort appear once a collection reaches the count set in Theme settings → Bush Riding." }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "text", "id": "match", "label": "Product type or collection handle", "info": "Exactly as in Shopify, e.g. Shorts (a product Type) or bush-riding-launch (a collection's handle). Capitals don't matter." },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Full width. Leave empty for words only." },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the type or collection name." },
        { "type": "text", "id": "tagline", "label": "Short line", "info": "Set in capitals under the title, e.g. Made for the long way round." },
        { "type": "textarea", "id": "text", "label": "Text", "info": "Two or three sentences." }
      ]
    }
  ]
}
{% endschema %}
