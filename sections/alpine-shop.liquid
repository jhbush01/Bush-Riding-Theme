{%- comment -%}
  Shop landing (D02 / M03) — /collections.

  Desktop: 800px, three columns 320px | 1fr | 1fr. Left, the category list in
  Archivo with next-drop categories muted, and pinned to its foot the local
  time and weather and a compact newsletter. Middle, the product on its plain
  ground; right, a lifestyle photo for the live category.

  Phone: category rows (Bottoms "1 style →", the next-drop ones folded into
  one row), the product card with Quick add +, one lifestyle photo.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = collections['bush-riding-launch'].products.first | default: collections.all.products.first
  endif
  assign c = section.settings.collection
  assign panel = section.settings.product_image | default: p.featured_media.preview_image
  assign life = section.settings.lifestyle
  assign c_url = c.url | default: routes.all_products_collection_url
  assign c_label = section.settings.lifestyle_label | default: c.title
-%}
<section class="alp alp-shop">
  <div class="alp-shop__grid alp-d">
    <div class="alp-shop__side">
      <nav class="alp-cats alp-cats--big" aria-label="Categories">
        {%- render 'alp-shop-links', variant: 'list' -%}
      </nav>
      <span class="alp-shop__fill"></span>
      <p class="alp-shop__now">
        Local time <span data-alp-clock>{{ 'now' | date: '%H:%M' }}</span><br>
        {{ settings.alp_place | escape }}
        <span data-alp-wx-wrap hidden><br><span data-alp-wx-text data-alp-wx-format="dot"></span></span>
      </p>
      {%- render 'alp-signup', id: 'ShopNewsletter', tags: 'newsletter', label: 'Subscribe', size: 'sm' -%}
      <p class="alp-shop__fine">We send the occasional route, nothing else.</p>
    </div>
    <a class="alp-shop__panel alp-shop__panel--ground" href="{{ p.url | default: c_url }}">
      {%- if panel != blank -%}
        {{ panel | image_url: width: 1400 | image_tag: class: 'alp-fill', loading: 'eager', widths: '600, 900, 1400', sizes: '40vw', alt: '' }}
      {%- endif -%}
      {%- if p != blank -%}<span class="alp-shop__label">{{ p.title | escape }}</span>{%- endif -%}
    </a>
    <a class="alp-shop__panel" href="{{ c_url }}">
      {%- if life != blank -%}
        {{ life | image_url: width: 1400 | image_tag: class: 'alp-fill', loading: 'eager', widths: '600, 900, 1400', sizes: '40vw', alt: '' }}
      {%- endif -%}
      {%- if c_label != blank -%}<span class="alp-shop__label alp-shop__label--bone">{{ c_label | escape }}</span>{%- endif -%}
    </a>
  </div>

  <div class="alp-m">
    <nav class="alp-rows" aria-label="Categories">
      {%- render 'alp-shop-links', variant: 'rows' -%}
    </nav>
    {%- if p != blank -%}
      {%- render 'alp-card', product: p, loading: 'eager' -%}
    {%- endif -%}
    {%- if life != blank -%}
      <a class="alp-photo alp-photo--500" href="{{ c_url }}">
        {{ life | image_url: width: 1200 | image_tag: class: 'alp-fill', loading: 'lazy', widths: '600, 900, 1200', sizes: '100vw', alt: c_label | default: '' }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop landing",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Featured product", "info": "Leave empty to use the first product in the store." },
    { "type": "image_picker", "id": "product_image", "label": "Product image (desktop)", "info": "The product on a plain ground. Defaults to its first photo." },
    { "type": "collection", "id": "collection", "label": "Lifestyle panel links to" },
    { "type": "image_picker", "id": "lifestyle", "label": "Lifestyle photo" },
    { "type": "text", "id": "lifestyle_label", "label": "Lifestyle label", "default": "Bottoms", "info": "Leave empty to use the collection's title." }
  ]
}
{% endschema %}
